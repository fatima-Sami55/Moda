<style>
header {
  width: 100%;
  height: 90px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  background-color: var(--bg-deep) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  padding: 0 40px;
  border-bottom: 1px solid var(--border-light);
  box-shadow: var(--shadow-premium);
  transition: var(--transition-smooth);
}

header .logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

header .logo h3 a {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-family: var(--font-heading) !important;
}

header .logo h3 a span {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  font-size: 26px;
  color: var(--text-primary) !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  -webkit-text-fill-color: unset !important;
  letter-spacing: -0.02em;
}

header .logo img {
  filter: drop-shadow(0 0 8px var(--border-glow));
}

#chk1 {
  display: none;
}

header .menu {
  font-size: 2.5rem;
  display: none;
  color: var(--text-primary);
  cursor: pointer;
}

header .menu label i {
  color: var(--text-primary) !important;
}

header ul {
  display: flex;
  flex: 2;
  justify-content: space-evenly;
  align-items: center;
}

header ul li {
  list-style: none;
  position: relative;
}

header ul li a {
  text-decoration: none;
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-secondary) !important;
  text-transform: uppercase;
  font-size: 18px;
  letter-spacing: 0.05em;
  padding: 10px 15px;
  transition: var(--transition-smooth);
}

header ul li a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15px;
  right: 15px;
  height: 2px;
  background: var(--accent-gradient);
  transform: scaleX(0);
  transition: var(--transition-smooth);
}

header ul li a:hover {
  color: var(--text-primary) !important;
}

header ul li a:hover::after {
  transform: scaleX(1);
}

header a,
header a:visited,
header a:hover,
header a:active,
header a:focus {
  color: var(--text-primary) !important;
  text-decoration: none;
}

@media (max-width: 1000px) {
  header .menu {
    display: block;
    position: absolute;
    top: 25px;
    right: 30px;
    z-index: 1001;
  }

  header ul {
    position: fixed;
    top: 90px;
    right: -100%;
    width: 60%;
    height: calc(100vh - 90px);
    background-color: var(--bg-surface) !important;
    border-left: 1px solid var(--border-light);
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: 40px;
    gap: 40px;
    transition: right 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: var(--shadow-premium);
    z-index: 1000;
  }

  #chk1:checked ~ ul {
    right: 0;
  }
}
</style>

<!-- Global Neobrutalist Toast component included -->
<%- include('toast') %>

<header id="navbar" class="nav-after">
  <!-- Hidden checkbox to control menu toggle -->
  <input type="checkbox" id="chk1">

  <!-- Logo -->
  <div class="logo">
    <h3>
      <a
        href="/home"
        class="flex items-center space-x-3 rtl:space-x-reverse"
        style="text-decoration: none; color: black"
      >
        <img
          src="../image/moda-logo/logo.png"
          class="h-8"
          alt="Moda Logo"
          style="width: 60px; height: 60px"
        />
        <span
          class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
          >Moda</span
        >
      </a>
    </h3>
  </div>
  <!-- Hamburger Icon -->
  <label for="chk1" class="menu">
    <i class="fa fa-bars"></i>
  </label>

  <!-- Navigation Links -->
  <ul>
    <% if (page === 'inbox') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="/orders">Orders</a></li>
    <li><a href="/email">Email</a></li>
    <li><a href="/review">Reviews</a></li>
    <% } else if (page === 'orders') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="/inbox">Inbox</a></li>
    <li><a href="/email">Email</a></li>
    <li><a href="/review">Reviews</a></li>
    <% } else if (page === 'email') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="/inbox">Inbox</a></li>
    <li><a href="/orders">Orders</a></li>
    <li><a href="/review">Reviews</a></li>
    <% } else if (page === 'Reviews') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="/inbox">Inbox</a></li>
    <li><a href="/orders">Orders</a></li>
    <li><a href="/email">Email</a></li>
    <% } else if (page === 'track') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="/acessiories">Accessories</a></li>
    <li><a href="/orders">Back</a></li>
    <% } else if (page === 'shop') { %>
    <li><a href="/home">Home</a></li>
    <li><a href="#" class="nav-link category-link" data-category="men">Men</a></li>
    <li><a href="#" class="nav-link category-link" data-category="women">Women</a></li>
    <li><a href="#" class="nav-link category-link" data-category="kids">Kids</a></li>
    <% } %>
  </ul>
</header>

