<div class="row">
  <% data.forEach(item => { %>
    <div class="col-12 col-sm-6 col-lg-3 mb-5">
      <div class="card h-100 d-flex flex-column product-card">
        
        <!-- Premium Image Zoom Wrapper & Brand Tag -->
        <div class="product-img-wrapper">
          <img src="<%= item.image %>" loading="lazy" width="280" height="240" class="card-img-top smooth-image" alt="<%= item.name %>" />
          <span class="product-badge">MODA ORIGINAL</span>
        </div>
        
        <!-- Card Details -->
        <div class="card-body d-flex flex-column p-4">
          <h5 class="card-title mb-1 product-name"><%= item.name %></h5>
          <p class="card-text mb-3 product-description"><%= item.description %></p>
          
          <!-- Price and Ratings Row -->
          <div class="d-flex justify-content-between align-items-center mt-auto mb-4">
            <p class="mb-0 product-price">$<%= item.price %></p>
            <div class="ms-auto card-rating-trigger" style="cursor: pointer;" title="View reviews">
              <% const itemRating = (typeof ratingsMap !== 'undefined' && ratingsMap[item.name.toLowerCase().trim()]) || { avgRating: '0.0', totalReviews: 0 }; %>
              <% const avg = parseFloat(itemRating.avgRating || 0); %>
              <div class="rating-stars d-flex align-items-center gap-1">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= Math.floor(avg)) { %>
                    <i class="fa fa-star"></i>
                  <% } else if (i - 0.5 <= avg) { %>
                    <i class="fa fa-star-half-o"></i>
                  <% } else { %>
                    <i class="fa fa-star-o"></i>
                  <% } %>
                <% } %>
                <span class="text-muted ms-1 rating-count">(<%= itemRating.totalReviews %>)</span>
              </div>
            </div>
          </div>
          
          <!-- Streetwear CTA Button -->
          <button class="btn card-btn">VIEW PIECE &rarr;</button>
        </div>
      </div>
    </div>
  <% }) %>
</div>
