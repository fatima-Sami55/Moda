<style>
header {
  width: 100%;
  height: 90px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 999;
  background-color: var(--bg-deep) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  padding: 0 40px;
  border-bottom: 1px solid var(--border-light);
  box-shadow: var(--shadow-premium);
  transition: var(--transition-smooth);
}

header .logo {
  display: flex;
  align-items: center;
  gap: 10px;
}

header .logo h3 a {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-family: var(--font-heading) !important;
}

header .logo h3 a span {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  font-size: 26px;
  color: var(--text-primary) !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  -webkit-text-fill-color: unset !important;
  letter-spacing: -0.02em;
}

header .logo img {
  filter: drop-shadow(0 0 8px var(--border-glow));
}

header.nav-after {
  top: 0;
}

header.offset-top {
  top: 60px; 
}

@media (max-width: 804px) {
  body.unverified header.nav-after {
    top: 120px !important;
  }
  .user-dashboard {
    padding-top: 250px;
  }
}

@media (max-width: 360px) {
  body.unverified header.nav-after {
    top: 130px !important;
  }
}

#chk1 {
  display: none;
}

header .menu {
  font-size: 2.5rem;
  display: none;
  color: var(--text-primary);
  cursor: pointer;
}

header .menu label i {
  color: var(--text-primary) !important;
}

header ul {
  display: flex;
  flex: 2;
  justify-content: space-evenly;
  align-items: center;
  margin: 0;
  padding: 0;
}

header ul li {
  list-style: none;
  position: relative;
}

header ul li a {
  text-decoration: none;
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-secondary) !important;
  text-transform: uppercase;
  font-size: 18px;
  letter-spacing: 0.05em;
  padding: 10px 15px;
  transition: var(--transition-smooth);
}

header ul li a::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 15px;
  right: 15px;
  height: 2px;
  background: var(--accent-gradient);
  transform: scaleX(0);
  transition: var(--transition-smooth);
}

header ul li a:hover {
  color: var(--text-primary) !important;
}

header ul li a:hover::after {
  transform: scaleX(1);
}

header a,
header a:visited,
header a:hover,
header a:active,
header a:focus {
  color: var(--text-primary) !important;
  text-decoration: none;
}

@media (max-width: 1000px) {
  header .menu {
    display: block;
    position: absolute;
    top: 25px;
    right: 30px;
    z-index: 1001;
  }

  header ul {
    position: fixed;
    top: 90px;
    right: -100%;
    width: 60%;
    height: calc(100dvh - 90px);
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--bg-surface) !important;
    border-left: 1px solid var(--border-light);
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding-top: 40px;
    padding-bottom: 40px;
    gap: 40px;
    transition: right 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
    box-shadow: var(--shadow-premium);
    z-index: 1099;
  }

  body.unverified header ul {
    top: 130px;
    height: calc(100dvh - 130px);
    max-height: calc(100dvh - 130px);
  }

  #chk1:checked ~ ul {
    right: 0;
  }
}

header.checkout-nav {
  justify-content: center;
}

header.checkout-nav .logo {
  flex: 0 0 auto;
}

header.checkout-nav .menu,
header.checkout-nav .nav-links,
header.checkout-nav #chk1 {
  display: none !important;
}
</style>

<!-- Global Neobrutalist Toast component included -->
<%- include('toast') %>
<%
  let headerClass = 'nav-after';
  if (page === 'user' && !isVerified) {
    headerClass += ' offset-top';
  }
%>

<!-- Header -->
<header id="navbar" class="shadow p-3 mb-5 bg-body-tertiary rounded <%= headerClass %> <%= page === 'checkout' ? 'checkout-nav' : '' %>">
    <!-- Navbar logo -->
   <div class="logo">
    <h3>
      <a
        href="/home"
        class="flex items-center space-x-3 rtl:space-x-reverse"
        style="text-decoration: none; color: black"
      >
        <img
          src="../image/Acess logo/logo.png"
          class="h-8"
          alt="Moda Logo"
          style="width: 60px; height: 60px"
        />
        <span
          class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white"
          >Moda</span
        >
      </a>
    </h3>
  </div>
  <!-- Hamburger toggle -->
  <input type="checkbox" id="chk1" hidden />
  
  <!-- Hamburger Icon -->
  <div class="menu">
    <label for="chk1"><i class="fa fa-bars"></i></label>
  </div>

  <!-- Navigation Links -->
  <ul class="nav-links">
    <% if (page === 'wish') { %>
      <li><a href="/home">Home</a></li>
      <li><a href="/add-to-cart">Cart</a></li>
    <% } else if (page === 'cart') { %>
      <li><a href="/home">Home</a></li>
      <li><a href="/wish">Wishlist</a></li>
    <% } else if (page === 'user') { %>
      <li><a href="/home">Home</a></li>
      <li><a href="/wish">Wishlist</a></li>
      <li><a href="/add-to-cart">Cart</a></li>
    <% } %>
  </ul>
</header>


