<style>
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 0 40px;
  height: 90px;
  width: 100%;
  position: fixed;
  top: 0;
  background-color: var(--bg-deep) !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  z-index: 1100;
  border-bottom: 1px solid var(--border-light);
  box-shadow: var(--shadow-premium);
  transition: var(--transition-smooth);
}

header a,
header a:hover,
header a:focus {
  text-decoration: none !important;
}

header.nav-after {
  top: 0;
}

header.offset-top {
  top: 60px; 
}

@media (max-width: 804px) {
  body.unverified header.nav-after {
    top: 120px !important;
  }
  .banner {
    margin-top: 200px; 
  }
}

@media (max-width: 360px) {
  body.unverified header.nav-after {
    top: 130px !important;
  }
}

header .logo {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  margin-left: 0;
}

header .logo h3 a {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  font-family: var(--font-heading) !important;
}

header .logo h3 a span {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  font-size: 26px;
  color: var(--text-primary) !important;
  background: none !important;
  -webkit-background-clip: border-box !important;
  -webkit-text-fill-color: unset !important;
  letter-spacing: -0.02em;
}

header .logo img {
  filter: drop-shadow(0 0 8px var(--border-glow));
}

/* ======================== Nav Links ======================== */
header ul {
  display: flex;
  justify-content: space-evenly;
  align-items: center;
  list-style: none;
  flex: 2;
  margin: 0;
  padding: 0;
}

header ul li.link {
  position: relative;
}

header ul li.link a {
  text-decoration: none;
  font-family: var(--font-heading);
  font-weight: 600;
  color: var(--text-secondary) !important;
  text-transform: uppercase;
  font-size: 18px;
  letter-spacing: 0.05em;
  padding: 10px 15px;
  transition: var(--transition-smooth);
}

header ul li.link a::after {
  content: '' !important;
  position: absolute;
  bottom: 0;
  left: 15px;
  right: 15px;
  height: 2px;
  background: var(--accent-gradient) !important;
  transform: scaleX(0);
  transition: var(--transition-smooth);
  border: none !important;
  display: block !important;
  margin: 0 !important;
  vertical-align: normal !important;
}

header ul li.link a:hover {
  color: var(--text-primary) !important;
}

header ul li.link a:hover::after {
  transform: scaleX(1) !important;
}

#user:hover {
  border-bottom: none !important;
}

/* ======================== Dropdown ======================== */
.dropdown-toggle::after {
  content: none !important;
}

header .dropdown-menu {
  background: var(--bg-surface-glass) !important;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--border-light) !important;
  box-shadow: var(--shadow-premium) !important;
  border-radius: 14px;
  padding: 8px;
  margin-top: 10px;
}

header .dropdown-item {
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary) !important;
  padding: 10px 16px;
  border-radius: 8px;
  transition: var(--transition-smooth);
}

header .dropdown-item:hover {
  background-color: rgba(232, 196, 58, 0.15) !important;
  color: var(--text-primary) !important;
  transform: translateX(4px);
}

header .dropdown-divider {
  border-color: var(--border-light);
}

header .dropdown-item:active,
header .dropdown-item:visited {
  background-color: transparent;
}

header .dropdown-item p {
  margin: 0;
}

/* ======================== Search Bar ======================== */
.search-container {
  margin-top: 0;
}

.search-form .form-group {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: 20px;
  background-color: rgba(26, 26, 26, 0.06);
  border: 1px solid var(--border-light);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  transition: var(--transition-smooth);
}

.search-form .form-group input.form-control {
  width: 0;
  padding: 0px !important;
  padding-right: 35px !important;
  border: none !important;
  background: transparent !important;
  box-shadow: none !important;
  color: var(--text-primary) !important;
  font-family: var(--font-body);
  font-size: 14px;
  transition: width 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.search-form .form-group input.form-control:focus,
.search-form .form-group:hover input.form-control {
  width: 260px;
  padding: 0px !important;
  padding-left: 15px !important;
  padding-right: 35px !important;
  background-color: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.search-form .form-group:focus-within,
.search-form .form-group:hover {
  width: 260px;
  background-color: rgba(26, 26, 26, 0.12);
  border-color: var(--primary-accent);
  box-shadow: var(--shadow-glow);
}

.search-form .form-group span.form-control-feedback {
  position: absolute;
  right: 0;
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  cursor: pointer;
  pointer-events: none;
}

.search-form .form-group span.form-control-feedback i {
  color: var(--text-secondary) !important;
  transition: var(--transition-smooth);
}

.search-form .form-group:focus-within span.form-control-feedback i {
  color: var(--primary-accent) !important;
}

/* ======================== Hamburger Icon ======================== */
#chk1 {
  display: none;
}

.menu {
  display: none;
  font-size: 28px;
  cursor: pointer;
  color: var(--text-primary);
}

/* ======================== User Image / Cart ======================== */
#user-img {
  height: 42px;
  width: 42px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border-light);
  transition: var(--transition-smooth);
}

#user-img:hover {
  border-color: var(--primary-accent);
  box-shadow: var(--shadow-glow);
}

header ul.nav-links li.user-actions {
  display: flex !important;
  align-items: center !important;
  gap: 15px !important;
}

#cart {
  margin-left: 15px;
  display: flex;
  align-items: center;
  position: relative;
}

#cart i.material-icons {
  color: var(--text-secondary) !important;
  font-size: 28px;
  transition: var(--transition-smooth);
}

#cart:hover i.material-icons {
  color: var(--text-primary) !important;
  transform: scale(1.1);
}

header .notification-counter {
  background: var(--accent-gradient) !important;
  border: none !important;
  box-shadow: var(--shadow-glow);
  font-weight: 700;
  color: white !important;
}

body.unverified .banner {
  height: 100vh;
  background-size: cover;
  background-position: center;
  margin-top: 100px;
}

@media (max-width: 1024px) {
  header {
    flex-direction: column;
    height: auto;
    padding: 15px 30px;
    align-items: flex-start;
    position: fixed;
    width: 100%;
    z-index: 1100;
  }

  .menu {
    display: block;
    position: absolute;
    top: 25px;
    right: 30px;
    z-index: 1001;
  }

  .menu i {
    color: var(--text-primary) !important;
  }

  header ul {
    flex-direction: column;
    align-items: center;
    position: fixed;
    top: 90px; 
    right: -100%;
    background-color: var(--bg-surface) !important;
    border-left: 1px solid var(--border-light);
    width: 60%;
    height: calc(100dvh - 90px);
    max-height: calc(100dvh - 90px);
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: right 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
    z-index: 1099;
    box-shadow: var(--shadow-premium);
    padding-top: 40px;
    padding-bottom: 40px;
    gap: 40px;
  }

  body.unverified header ul {
    top: 130px; 
    height: calc(100dvh - 130px);
    max-height: calc(100dvh - 130px);
  }

  #chk1:checked ~ ul {
    right: 0;
  }

  .search-form .form-group:hover input.form-control,
  .search-form .form-group input.form-control:focus {
    width: 200px;
  }
}

/* Small Tablet — max 768px */
@media (max-width: 768px) {
  header {
    padding: 12px 20px;
  }

  .menu {
    top: 18px;
    right: 20px;
  }

  header ul {
    width: 72%;
    gap: 32px;
    top: 84px;
    height: calc(100dvh - 84px);
    max-height: calc(100dvh - 84px);
  }

  .search-form .form-group:hover input.form-control,
  .search-form .form-group input.form-control:focus {
    width: 160px;
  }
}

/* Mobile — max 576px */
@media (max-width: 576px) {
  header {
    padding: 10px 16px;
  }

  .menu {
    top: 16px;
    right: 16px;
    font-size: 24px;
  }

  header .logo h3 a span {
    font-size: 20px !important;
  }

  header .logo img {
    width: 46px !important;
    height: 46px !important;
  }

  header ul {
    width: 82%;
    gap: 28px;
    padding-top: 28px;
    top: 66px;
    height: calc(100dvh - 66px);
    max-height: calc(100dvh - 66px);
  }

  header ul li.link a {
    font-size: 15px !important;
  }

  .search-form .form-group:hover input.form-control,
  .search-form .form-group input.form-control:focus {
    width: 130px;
  }
}

/* Small Mobile — max 400px */
@media (max-width: 400px) {
  header {
    padding: 8px 12px;
  }

  header .logo h3 a span {
    font-size: 18px !important;
  }

  header .logo img {
    width: 38px !important;
    height: 38px !important;
  }

  header ul {
    width: 88%;
    top: 54px;
    height: calc(100dvh - 54px);
    max-height: calc(100dvh - 54px);
  }

  .search-form .form-group:hover input.form-control,
  .search-form .form-group input.form-control:focus {
    width: 110px;
  }
}
</style>
