<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
footer#footer {
  margin-top: 80px;
  width: 100%;
}

footer#footer .main-footer {
  padding: 80px 0 50px 0;
  background-color: var(--bg-deep) !important; /* Integrated lookbook background */
  border-top: 2px solid var(--text-primary); /* Bold border */
}

footer#footer .main-footer .row {
  display: flex;
  flex-wrap: wrap;
  row-gap: 10px;
}

footer#footer .main-footer .row > [class*="col-"] {
  min-width: 0;
}

footer#footer ul {
  padding-left: 0;
  list-style: none;
  margin: 0;
}

footer#footer .widget {
  padding: 0;
  margin-bottom: 40px;
}

footer#footer .widget.no-box {
  background-color: transparent;
  box-shadow: none;
}

footer#footer .widget-title {
  font-family: var(--font-heading) !important;
  font-weight: 700;
  font-size: 1.8rem;
  color: var(--text-primary) !important;
  margin-bottom: 25px;
  position: relative;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  line-height: 1.2;
  overflow-wrap: anywhere;
}

footer#footer .widget-title span {
  display: none; /* Clean minimal lookbook layout without underline indicators */
}

footer#footer p {
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.7;
  color: var(--text-secondary) !important;
  margin-bottom: 20px;
}

footer#footer .widget li {
  margin-bottom: 12px;
}

footer#footer .widget li a {
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--text-secondary) !important;
  text-decoration: none !important;
  transition: var(--transition-smooth);
  display: inline-block;
  max-width: 100%;
  overflow-wrap: anywhere;
}

footer#footer .widget li a:hover {
  color: var(--text-primary) !important;
  transform: translateX(6px);
}

/* Footer CTAs */
footer#footer .btn-buy {
  background: var(--primary-accent) !important; /* Solar Yellow CTA */
  color: var(--text-primary) !important;
  border: 2px solid var(--text-primary) !important;
  border-radius: 50px !important; /* Pill style */
  font-family: var(--font-heading) !important;
  font-weight: 700 !important;
  font-size: 1.1rem;
  padding: 10px 24px !important;
  display: inline-block;
  max-width: 100%;
  text-decoration: none !important;
  box-shadow: 3px 3px 0px var(--text-primary) !important;
  transition: var(--transition-smooth) !important;
  white-space: normal;
}

footer#footer .btn-buy:hover {
  transform: translate(-2px, -2px) !important;
  background-color: var(--secondary-accent) !important; /* Burn Orange hover */
  color: white !important;
  box-shadow: 5px 5px 0px var(--text-primary) !important;
}

/* Contact Info link */
footer#footer a.email-link {
  font-family: var(--font-body);
  font-weight: 600;
  color: var(--secondary-accent) !important;
  text-decoration: none !important;
  transition: var(--transition-smooth);
}

footer#footer a.email-link:hover {
  color: var(--text-primary) !important;
  text-decoration: underline !important;
}

/* Social media list */
footer#footer ul.social-footer2 {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 15px;
}

footer#footer ul.social-footer2 li {
  margin: 0;
  background: transparent !important;
  background-color: transparent !important;
  border: none !important;
  padding: 0 !important;
}

footer#footer ul.social-footer2 li a {
  display: flex !important;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: rgba(26, 26, 26, 0.05);
  border: 2px solid var(--text-primary);
  color: var(--text-primary) !important;
  transition: var(--transition-smooth) !important;
  font-size: 18px;
}

footer#footer ul.social-footer2 li a:hover {
  color: var(--text-primary) !important;
  background-color: var(--primary-accent) !important; /* Unified solar yellow hover */
  transform: translate(-2px, -2px) scale(1.05);
  box-shadow: 3px 3px 0px var(--text-primary) !important;
}

/* Copyright Footer */
footer#footer .footer-copyright {
  background-color: var(--bg-deep) !important;
  padding: 25px 0;
  border-top: 2px solid var(--text-primary) !important; /* Matching lookbook dividers */
}

footer#footer .footer-copyright p {
  margin: 0;
  font-family: var(--font-body);
  font-size: 14px;
  color: var(--text-primary) !important;
  font-weight: 500;
  text-align: center;
}

@media (max-width: 991.98px) {
  footer#footer .main-footer {
    padding: 60px 0 36px 0;
  }

  footer#footer .widget-title {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
  }
}

@media (max-width: 575.98px) {
  footer#footer {
    margin-top: 56px;
  }

  footer#footer .main-footer {
    padding: 44px 0 22px 0;
  }

  footer#footer .main-footer .row > [class*="col-"] {
    flex: 0 0 100%;
    max-width: 100%;
  }

  footer#footer .widget {
    margin-bottom: 30px;
  }

  footer#footer .widget-title {
    font-size: 1.25rem;
    margin-bottom: 16px;
  }

  footer#footer p,
  footer#footer .widget li a {
    font-size: 14px;
  }

  footer#footer .footer-copyright {
    padding: 18px 0;
  }
}
</style>

