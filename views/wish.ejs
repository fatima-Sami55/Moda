<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Moda - Wishlist'}) %>
  <body>
    <!-- stylesheets -->
    <link rel="stylesheet" href="../css/wish.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
      rel="stylesheet"
    />

    <!-- Navbar -->
    <%- include('../partials/navbar_carts', { page: page }) %>

    <!-- Neobrutalist Deletion Confirmation Overlay -->
    <div id="wishlist-confirm-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(31, 30, 35, 0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 10000; align-items: center; justify-content: center;">
      <div style="background: #FFFFFF; border: 3px solid #1F1E23; box-shadow: 8px 8px 0px #1F1E23; max-width: 480px; width: 100%; padding: 40px; text-align: center; border-radius: 0px;">
        <div style="width: 70px; height: 70px; background: #FFECEC; border: 3px solid #1F1E23; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 3px 3px 0px #1F1E23;">
          <i class="fa-solid fa-heart-circle-xmark" style="font-size: 1.8rem; color: #6A69FF;"></i>
        </div>
        <h4 style="font-family: var(--font-heading), sans-serif; font-weight: 800; text-transform: uppercase; color: #1F1E23; font-size: 1.25rem; letter-spacing: 0.02em; margin-bottom: 12px;">Remove Style?</h4>
        <p style="font-family: var(--font-body), sans-serif; font-weight: 500; color: #555; font-size: 0.95rem; line-height: 1.6; margin-bottom: 30px;">Are you sure you want to remove this style from your wishlist? You will have to search for it again in our collection.</p>
        <div class="d-flex align-items-center justify-content-center gap-3">
          <button id="overlay-confirm-btn" class="btn px-4 py-2" style="background: #FE672E; color: #FFFFFF; border: 3px solid #1F1E23; font-family: var(--font-heading), sans-serif; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: 3px 3px 0px #1F1E23; border-radius: 0px; transition: all 0.15s ease;">Yes, Remove</button>
          <button id="overlay-cancel-btn" class="btn px-4 py-2" style="background: #FFFFFF; color: #1F1E23; border: 3px solid #1F1E23; font-family: var(--font-heading), sans-serif; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: 3px 3px 0px #1F1E23; border-radius: 0px; transition: all 0.15s ease;">No, Keep It</button>
        </div>
      </div>
    </div>

    <% if (data.length === 0) { %>
      <!-- Empty Wishlist Showcase -->
      <div class="container text-center wish-container-empty my-5">
        <div class="empty-wishlist-showcase">
          <img
            src="/image/vectors/empty_wishlist.svg"
            alt="Wishlist is empty"
            class="img-fluid empty-wishlist-img"
          />
          <h2 class="mt-4 empty-wishlist-heading">Your Wishlist is Empty</h2>
          <p class="empty-wishlist-sub">Looks like you haven't saved any true styles to your wishlist yet.</p>
          <a href="/acessiories" class="btn btn-warning mt-3">
            <i class="fa fa-chevron-left me-2"></i> Browse Collection
          </a>
        </div>
      </div>
    <% } else { %>
      <!-- Active Wishlist Curated Showcase -->
      <div class="container wish-container my-5">
        
        <!-- Curated Minimal Header -->
        <div class="d-flex justify-content-between align-items-baseline mb-4 border-bottom border-1 border-dark pb-2">
          <h1 class="wish-main-title mb-0">My Wishlist</h1>
          <span class="wishlist-count-text"><%= data.length %> styles saved</span>
        </div>
        
        <div class="wishlist-list-wrapper">
          <% data.forEach(item => { %>
            <div class="wishlist-item-row wishlist-item-container py-4 border-bottom border-light">
              <div class="row align-items-center">
                
                <!-- Product Image (Unbordered, organic) -->
                <div class="col-4 col-sm-2 c-img text-center text-sm-start position-relative">
                  <img src="<%= item.item_image %>" alt="<%= item.item_Name %>" class="wishlist-item-img img-fluid" />
                  <div class="wishlist-heart-badge">
                    <i class="fa-solid fa-heart"></i>
                  </div>
                </div>
                
                <!-- Product Content Details -->
                <div class="col-8 col-sm-6 col-md-7">
                  <div class="d-flex flex-column gap-1">
                    <h3 class="wishlist-item-name c-title text-capitalize mb-1">
                      <strong><%= item.item_Name %></strong>
                    </h3>
                    <div class="wishlist-stars mb-1">
                      <% 
                        const normalizedName = item.item_Name.toLowerCase().trim();
                        const ratingInfo = typeof ratingsMap !== 'undefined' && ratingsMap[normalizedName];
                        const avgRating = ratingInfo ? Math.round(parseFloat(ratingInfo.avgRating)) : 0; 
                      %>
                      <% for(let i = 1; i <= 5; i++) { %>
                        <i class="fa-<%= i <= avgRating ? 'solid' : 'regular' %> fa-star"></i>
                      <% } %>
                    </div>
                    <p class="wishlist-item-desc mb-2">
                      <span class="c-text"><%= item.item_description %></span>
                    </p>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <div class="wishlist-item-price c-price">$<%= item.item_price %></div>
                      <span class="wishlist-curated-tag"><i class="fa-solid fa-heart me-1"></i> CURATED STYLE</span>
                    </div>
                  </div>
                </div>
                
                <!-- Minimal Action operations triggers -->
                <div class="col-12 col-sm-4 col-md-3 d-flex flex-row flex-sm-column gap-3 justify-content-start justify-content-sm-end align-items-center align-items-sm-end mt-3 mt-sm-0">
                  <!-- Add to Cart AJAX action -->
                  <button class="btn wishlist-action-btn btn-cart px-4 py-2" title="Add to Cart">
                    Add to Cart <i class="fa fa-arrow-right ms-2"></i>
                  </button>
                  
                  <!-- Remove wishlist item -->
                  <form action="/delete/wishItem/<%= item.id %>" method="POST" class="m-0 wishlist-remove-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="button" class="wishlist-remove-btn" title="Remove Style">
                      <i class="fa-regular fa-trash-can me-1"></i> REMOVE
                    </button>
                  </form>
                </div>
                
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <%- include('../partials/footer') %>

    <!-- Scripts -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>

    <!-- AJAX Add to Cart Handler and Overlay script -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Add to Cart
        document.querySelectorAll(".btn-cart").forEach((button) => {
          button.addEventListener("click", async (event) => {
            if (button.disabled) return;
            const originalHTML = button.innerHTML;
            button.disabled = true;
            button.style.opacity = '0.7';
            button.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Adding...';
            try {
              const cardContainer = button.closest(".wishlist-item-container");
              const itemNameElement = cardContainer.querySelector(".c-title strong");
              const itemImageElement = cardContainer.querySelector(".c-img img");
              const itemDescriptionElement = cardContainer.querySelector(".c-text");
              const itemPriceElement = cardContainer.querySelector(".c-price");

              if (itemNameElement && itemImageElement && itemDescriptionElement && itemPriceElement) {
                const itemName = itemNameElement.innerText.trim();
                const itemImage = itemImageElement.src;
                const itemDescription = itemDescriptionElement.innerText.trim();
                const itemPrice = parseFloat(itemPriceElement.innerText.replace(/[^0-9.]/g, "").trim());

                const response = await fetch("/add-to-cart", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                    "X-Requested-With": "XMLHttpRequest"
                  },
                  body: JSON.stringify({
                    itemName,
                    itemImage,
                    itemDescription,
                    itemPrice,
                    _csrf: "<%= csrfToken %>"
                  }),
                });

                const data = await response.json();
                if (response.ok) {
                  showToast(data.message || "Item added to cart successfully!", "success");
                  setTimeout(() => {
                    window.location.href = "/add-to-cart";
                  }, 1500);
                } else {
                  showToast(`${data.error || data.message}`, "error");
                  button.disabled = false;
                  button.style.opacity = '';
                  button.innerHTML = originalHTML;
                }
              }
            } catch (error) {
              showToast("Error: " + error, "error");
              console.error(error);
              button.disabled = false;
              button.style.opacity = '';
              button.innerHTML = originalHTML;
            }
          });
        });

        // Soft confirmation overlay for removal
        let activeRemoveForm = null;
        const overlay = document.getElementById("wishlist-confirm-overlay");

        document.addEventListener("click", (event) => {
          const removeBtn = event.target.closest(".wishlist-remove-btn");
          if (removeBtn) {
            event.preventDefault();
            activeRemoveForm = removeBtn.closest("form");
            overlay.style.display = "flex";
          }
        });

        document.getElementById("overlay-cancel-btn").addEventListener("click", () => {
          overlay.style.display = "none";
          activeRemoveForm = null;
        });

        document.getElementById("overlay-confirm-btn").addEventListener("click", () => {
          if (activeRemoveForm) {
            const confirmBtn = document.getElementById("overlay-confirm-btn");
            confirmBtn.disabled = true;
            confirmBtn.textContent = "Removing...";
            activeRemoveForm.submit();
          }
        });
      });
    </script>
  </body>
</html>
