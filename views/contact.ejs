<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Moda — Contact Us'}) %>
  <body>
    <!-- Stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link href="/css/contact.css" rel="stylesheet" type="text/css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <!-- Navbar -->
    <%- include('../partials/navbar', { page: page }) %>

    <!-- Contact Page Container -->
    <main class="contact-section-wrapper">
      <!-- Title Header Row -->
      <div class="contact-header-row text-start">
        <h1 class="contact-main-title">
          <span style="white-space: nowrap;"><span class="outlined-word">THE CONTACT</span> GRID</span>
        </h1>
        <span class="contact-subtitle-tag">SUPPORT & INQUIRIES</span>
      </div>

      <!-- Main Layout Grid -->
      <div class="row align-items-start g-5 mb-5">
        <!-- Left Side: HQ Logistics Channels -->
        <div class="col-12 col-lg-5 contact-left-column">
          <p class="contact-lead-text">
            Have questions about your order, custom sizing, or our global shipping guidelines? Reach out directly. Our support staff operates 24/7.
          </p>

          <!-- Support Channels -->
          <div class="channel-card shadow-sm">
            <h5 class="channel-title">
              <i class="fa fa-envelope"></i> CLIENT SUPPORT
            </h5>
            <p class="channel-detail">
              Email: <a href="mailto:support@moda.com">support@moda.com</a><br />
              Expect a response in under 2 hours.
            </p>
          </div>

          <div class="channel-card shadow-sm">
            <h5 class="channel-title">
              <i class="fa fa-phone"></i> CORPORATE PHONE
            </h5>
            <p class="channel-detail">
              Call: +1 (800) 555-MODA<br />
              Mon - Fri: 9:00 AM - 6:00 PM EST.
            </p>
          </div>

          <div class="channel-card shadow-sm">
            <h5 class="channel-title">
              <i class="fa fa-map-marker"></i> GLOBAL HEADQUARTERS
            </h5>
            <p class="channel-detail">
              Moda Retail Co. LLC<br />
              500 Fashion District Avenue, Suite 12B<br />
              New York, NY 10018
            </p>
          </div>
        </div>

        <!-- Right Side: Minimal Inquiry Form -->
        <div class="col-12 col-lg-7 contact-right-column">
          <div class="contact-form-card shadow-lg">
            <h3 class="form-intro-title">SUBMIT AN INQUIRY</h3>
            <form class="row g-4 needs-validation" novalidate id="clientInquiryForm">
              <!-- Subject -->
              <div class="col-12">
                <label for="inquirySubject" class="form-label">Inquiry Subject</label>
                <input type="text" class="form-control" id="inquirySubject" placeholder="Order Tracking #..." required />
              </div>

              <!-- Message -->
              <div class="col-12">
                <label for="clientMessage" class="form-label">Message Details</label>
                <textarea class="form-control" id="clientMessage" rows="5" placeholder="Write your message here..." required></textarea>
              </div>

              <!-- Submit Button -->
              <div class="col-12">
                <button type="submit" class="btn form-submit-btn">Send Message</button>
              </div>
            </form>
          </div>
        </div>
      </div>

      <!-- Social Media Badge Matrix -->
      <div class="social-matrix-row text-start mb-5">
        <h3 class="matrix-title">Follow our socials</h3>
        <div class="matrix-grid">
          <a href="https://instagram.com" target="_blank" class="matrix-badge">
            <i class="fab fa-instagram"></i> Instagram
          </a>
          <a href="https://facebook.com" target="_blank" class="matrix-badge">
            <i class="fab fa-facebook-f"></i> Facebook
          </a>
          <a href="https://twitter.com" target="_blank" class="matrix-badge">
            <i class="fab fa-twitter"></i> Twitter / X
          </a>
          <a href="https://youtube.com" target="_blank" class="matrix-badge">
            <i class="fab fa-youtube"></i> YouTube
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer') %>
  </body>

  <!-- Scripts -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"
  ></script>
  <script
    src="https://kit.fontawesome.com/542d90fccf.js"
    crossorigin="anonymous"
  ></script>

  <!-- Client-side Validation Interceptor -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const form = document.getElementById("clientInquiryForm");
      if (!form) return;

      form.addEventListener("submit", function (e) {
        e.preventDefault();

        // Standard HTML5 validation check
        if (!form.checkValidity()) {
          e.stopPropagation();
          form.classList.add("was-validated");
          if (window.showToast) {
            window.showToast("Please fill in all fields correctly.", "error");
          }
          return;
        }

        // Show loading state
        const btn = form.querySelector(".form-submit-btn");
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Sending...';

        const subject = document.getElementById("inquirySubject").value;
        const message = document.getElementById("clientMessage").value;

        fetch("/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({ subject, message })
        })
          .then(async (response) => {
            const data = await response.json();
            if (data.success) {
              if (window.showToast) {
                window.showToast(data.success, "success");
              }
              form.reset();
              form.classList.remove("was-validated");
            } else {
              if (window.showToast) {
                window.showToast(data.error || "Failed to send message.", "error");
              }
            }
            btn.disabled = false;
            btn.innerHTML = originalText;
          })
          .catch((err) => {
            console.error("Contact Form Submit Error:", err);
            if (window.showToast) {
              window.showToast("Something went wrong. Please try again.", "error");
            }
            btn.disabled = false;
            btn.innerHTML = originalText;
          });
      });
    });
  </script>
</html>
