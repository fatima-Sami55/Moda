<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', {title: 'Moda'}) %>
  <body class="<%= isVerified ? '' : 'unverified' %>">

    <!-- Stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link href="/css/home.css" rel="stylesheet" type="text/css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <!-- Email verification flash -->
    <% if (!isVerified) { %>
    <div class="verification-strip">
      <div class="container-fluid d-flex align-items-center justify-content-between h-100 px-3 px-md-4">
        <div class="d-flex align-items-center text-truncate gap-2">
          <span class="strip-emoji">⚠️</span>
          <span class="strip-text">
            <strong>Account Unverified</strong>
            <%= resendAttempts >= 3
              ? "(Resend limit reached for today. Check your inbox!)"
              : "Please verify your email address to unlock full premium features." %>
          </span>
        </div>
        <div class="strip-action">
          <% if (resendAttempts < 3) { %>
            <form id="resend-verification-form" class="d-inline">
              <input type="hidden" name="email" value="<%= email %>">
              <button type="submit" class="strip-action-btn btn">Resend Email</button>
            </form>
          <% } else { %>
            <button class="strip-action-btn btn disabled" disabled>Resend Disabled</button>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Navbar -->
    <%- include('../partials/navbar', { page: page, isVerified: isVerified }) %>
    <% if (isLoggedIn) { %>
    <!-- Reimagined Editorial Hero Section -->
    <div class="editorial-hero">
      <div class="container-fluid h-100">
        <div class="row align-items-center h-100 g-0">
          
          <!-- Left Column: High-End Typography & Brand Copy -->
          <div class="col-12 col-lg-7 editorial-left d-flex align-items-center justify-content-center">
            <div class="editorial-text-wrapper text-start">
              <h1 class="editorial-main-title">
                <span class="outlined-word">FIND</span> YOUR<br />
                <span style="white-space: nowrap;">TRUE STYLE</span><br />
                HERE
              </h1>
              
              <!-- Capsule Pill Badge -->
              <div class="capsule-badge-row">
                <span class="capsule-pill">SUMMER IS COMING</span>
              </div>
              
              <p class="editorial-desc">
                Our fashion collection is made with high-quality materials and designed to fit your body like a glove. Shop now to find the perfect pieces for your wardrobe.
              </p>
              
              <!-- Hero Action Buttons: Explore Collection (Round button with arrow) -->
              <div class="editorial-action-row d-flex align-items-center gap-3 flex-wrap mt-4">
                <a href="#product" class="sticker-btn">
                  <span class="arrow-icon">&rarr;</span>
                </a>
              </div>
            </div>
          </div>
          
          <!-- Right Column: Real Human Fashion Portrait & Stickers -->
          <div class="col-12 col-lg-5 editorial-right position-relative">
            <!-- Main Photography Showcase Container -->
            <div class="editorial-image-frame">
              <img
                src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?q=80&w=800&auto=format&fit=crop"
                alt="Human Fashion Summer Showcase"
                class="editorial-main-image"
              />
              
              <!-- Rotating Summer Sale Sticker -->
              <div class="summer-sale-sticker">
                <div class="sticker-inner">
                  <span class="sticker-tag">SUMMER SALE</span>
                  <span class="sticker-discount">30% OFF</span>
                  <span class="sticker-tag">SHOP ACCESS</span>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <% } if (!isLoggedIn) { %>
    <!-- Reimagined Editorial Hero Section -->
    <div class="editorial-hero">
      <div class="container-fluid h-100">
        <div class="row align-items-center h-100 g-0">
          
          <!-- Left Column: High-End Typography & Brand Copy -->
