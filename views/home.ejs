  <!-- Scripts -->


<script>
  document.querySelectorAll(".card-btn").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();

      // Find the parent product card
      const productCard = event.target.closest(".product-card");

      if (!productCard) {
        alert("Product card not found");
        return;
      }

      // Extract data from the specific product card
      const itemName = productCard
        .querySelector(".product-brand")
        .innerText.trim();
      const itemImage = productCard.querySelector(".product-thumb").src;
      const itemDescription = productCard
        .querySelector(".product-short-description")
        .innerText.trim();
      const itemPrice = productCard
        .querySelector(".price")
        .innerText.replace("$", "")
        .trim();

      // Construct URL with encoded query parameters
      const url = new URL("/Product", window.location.origin);
      url.searchParams.set("name", encodeURIComponent(itemName));
      url.searchParams.set("img", encodeURIComponent(itemImage));
      url.searchParams.set("desc", encodeURIComponent(itemDescription));
      url.searchParams.set("price", encodeURIComponent(itemPrice));

      window.location.href = url.toString();
    });
  });

  document.querySelectorAll(".card-rating-trigger").forEach((element) => {
    element.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const productCard = event.target.closest(".product-card");
      if (!productCard) return;
      const itemName = productCard.querySelector(".product-brand").innerText.trim();
      const itemImage = productCard.querySelector(".product-thumb").src;
      const itemDescription = productCard.querySelector(".product-short-description").innerText.trim();
      const itemPrice = productCard.querySelector(".price").innerText.replace("$", "").trim();
      const url = new URL("/Product", window.location.origin);
      url.searchParams.set("name", encodeURIComponent(itemName));
      url.searchParams.set("img", encodeURIComponent(itemImage));
      url.searchParams.set("desc", encodeURIComponent(itemDescription));
      url.searchParams.set("price", encodeURIComponent(itemPrice));
      window.location.href = url.toString() + "#reviews";
    });
  });

  // Handle AJAX verification email resend on home page
  document.addEventListener("DOMContentLoaded", function () {
    const resendForm = document.getElementById("resend-verification-form");
    if (resendForm) {
      resendForm.addEventListener("submit", async function (event) {
        event.preventDefault();
        const submitBtn = resendForm.querySelector("button");
        const originalText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        try {
          const response = await fetch("/resend-verification", {
            method: "POST",
            headers: {
              "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams(new FormData(resendForm)).toString()
          });

          const data = await response.json();
          if (data.error) {
            if (window.showToast) {
              window.showToast(data.error, "error");
            }
            submitBtn.disabled = false;
            submitBtn.textContent = originalText;
          } else if (data.success) {
            if (window.showToast) {
              window.showToast(data.success, "success");
            }
            setTimeout(() => {
              window.location.reload();
            }, 1200);
          }
        } catch (err) {
          console.error("Resend Verification Error:", err);
          if (window.showToast) {
            window.showToast("Failed to send verification. Please try again.", "error");
          }
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
      });
    }
  });
</script>

