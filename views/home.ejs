      <!-- Products gallery -->
    <section class="product" id="product" style="padding-bottom: 70px">
      <h1
        class="product-category"
        style="padding-top: 40px; text-align: center;"
      >
        Products gallery
      </h1>
      <hr class="w-25 mx-auto" style="border-color: #1A1A1A !important; margin-bottom: 30px; opacity: 0.15;" />
      <div class="container product-container">
        <div class="row g-5 align-items-stretch">
          <% data.forEach(item => { %>
          <div class="col-12 col-sm-6 col-md-4 mb-5 d-flex">
            <div
              class="product-card w-100 d-flex flex-column justify-content-between"
              id="<%= item.id%>"
            >
              <span class="badge-best-selling">Best Selling</span>
              <div class="product-image">
                <img src="<%= item.image%>" class="product-thumb" alt="" />
              </div>
              <div class="product-info">
                <h4 class="product-brand"><%= item.name%></h4>
                <p class="product-short-description"><%= item.description%></p>
                <div class="text-warning mb-2 card-rating-trigger" style="font-size: 1.1rem; cursor: pointer;" title="View reviews">
                  <% const itemRating = (typeof ratingsMap !== 'undefined' && ratingsMap[item.name.toLowerCase().trim()]) || { avgRating: '0.0', totalReviews: 0 }; %>
                  <% const avg = parseFloat(itemRating.avgRating || 0); %>
                  <% for (let i = 1; i <= 5; i++) { %>
                    <% if (i <= Math.floor(avg)) { %>
                      <i class="fa fa-star"></i>
                    <% } else if (i - 0.5 <= avg) { %>
                      <i class="fa fa-star-half-o"></i>
                    <% } else { %>
                      <i class="fa fa-star-o"></i>
                    <% } %>
                  <% } %>
                  <span class="text-muted ms-1" style="font-size: 0.8rem;">(<%= itemRating.totalReviews %>)</span>
                </div>
                <span class="price">$<%= item.price%></span>
                <a href="/Product" class="card-btn">View product!</a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </section>
    <!-- Timeline -->
    <section class="timeline-section">
      <div class="container py-5">
        <h1 style="text-align: center;">Why Choose Us</h1>
        <hr class="w-25 mx-auto" style="border-color: #1A1A1A !important; margin-bottom: 50px; opacity: 0.15;" />
        <div class="main-timeline">
          <div class="timeline left">
            <div class="card">
              <div class="card-body p-4">
                <h3>2013 - Our Journey Begins</h3>
                <p class="mb-0">
                  Since 2013, Acess has been dedicated to offering the latest
                  trends in clothing and accessories, starting with a commitment
                  to quality and unique designs that set us apart from the
                  start.
                </p>
              </div>
            </div>
          </div>
          <div class="timeline right">
            <div class="card">
              <div class="card-body p-4">
                <h3>2015 - Expanding Our Collection</h3>
                <p class="mb-0">
                  By 2015, we had significantly expanded our collection to cater
                  to a wider audience, ensuring that our customers always find
                  something that matches their personal style and fashion needs.
                </p>
              </div>
            </div>
          </div>
          <div class="timeline left">
            <div class="card">
              <div class="card-body p-4">
                <h3>2017 - Launching Exclusive Collaborations</h3>
                <p class="mb-0">
                  In 2017, we began partnering with emerging designers to bring
                  exclusive, limited-edition collections to our customers,
                  providing them with fresh, innovative designs they won't find
                  anywhere else.
                </p>
              </div>
            </div>
          </div>
          <div class="timeline right">
            <div class="card">
              <div class="card-body p-4">
                <h3>2019 - Going Global</h3>
                <p class="mb-0">
                  Our global expansion in 2019 made it possible for customers
                  around the world to access our unique fashion pieces, allowing
                  us to share our passion for style on an international scale.
                </p>
              </div>
            </div>
          </div>
          <div class="timeline left">
            <div class="card">
              <div class="card-body p-4">
                <h3>2021 - Embracing Sustainability</h3>
                <p class="mb-0">
                  In 2021, we committed to sustainability by introducing
                  eco-friendly packaging and responsibly sourced materials,
                  showing our dedication to both high fashion and environmental
                  stewardship.
                </p>
              </div>
            </div>
          </div>
          <div class="timeline right">
            <div class="card">
              <div class="card-body p-4">
                <h3>2024 - Leading the Fashion Revolution</h3>
                <p class="mb-0">
                  By 2024, Acess has become a leader in the fashion industry,
                  known for our trendsetting collections, exceptional customer
                  service, and exclusive deals that keep our customers at the
                  forefront of fashion. Choose us to stay ahead in the fashion
                  game with the best in style and quality.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
