<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Authentication Required — Moda'}) %>
  <body>
    <link href="/css/protected.css" rel="stylesheet" type="text/css" />

    <main class="protected-container">
      <!-- Restriction Badge -->
      <span class="gate-badge">
        <span>🔒</span> Access Restricted
      </span>

      <!-- Illustration Area -->
      <div class="illustration-wrapper">
        <img
          src="/image/vectors/protected.png"
          alt="Locked Gate - Authentication Required"
          class="illustration-img"
        />
      </div>

      <!-- Text Blocks -->
      <h2 class="protected-title">Member Access Only</h2>
      <p class="protected-text">
        The destination you are trying to reach requires standard member credentials. Register a new account or log in to unleash your full fashion potential!
      </p>

      <!-- Auth Action Panel -->
      <div class="auth-actions">
        <a href="/login" class="btn-auth btn-login">Login</a>
        <a href="/signup" class="btn-auth btn-signup">Sign Up</a>
      </div>
    </main>
  </body>
</html>
