<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', {title: 'Acess'}) %>
  <body>
<!-- stylesheets -->
    <link rel="stylesheet" href="../css/email.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />

<!-- header section -->
<%- include('../partials/navbar_personal', { page: page }) %>
<!-- email counter section -->
<div class="container" style="padding-top: 200px;">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-6 col-md-4 text-center">
      <div class="counter-section">
        <i class="material-icons medium-icon" aria-hidden="true">mail</i>
        <span class="counter" id="notification-count">
          <%= logs.length < 10 ? '0' + logs.length : logs.length %>
        </span>
        <p class="counter-title">Total Mails</p>
      </div>
    </div>
  </div>
 </div>
<!-- email notification section -->
 <div class="container p-3 my-4">
  <% logs.forEach(log => { %>
    <div class="card mb-3">
      <div class="card-body d-flex flex-column flex-md-row align-items-start gap-3">
        
        <!-- Avatar -->
        <div class="flex-shrink-0">
          <img
            src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR6iCp_Trl81YenWR0daXCP4N_iPita92pZvg&usqp=CAU"
            alt="User"
            class="img-fluid rounded"
            style="width: 64px; height: 64px;"
          />
        </div>

        <!-- Content -->
        <div class="flex-grow-1 w-100">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <strong><%= log.userName %></strong>
            <span class="text-muted small">Email #<%= log.id %></span>
          </div>

          <p class="mb-2 text-muted small">
            <small>@<%= log.userName.replace(/\s/g, '') %></small> | 
            <small><%= new Date(log.sentAt).toLocaleTimeString() %></small>
          </p>

          <p class="mb-2">
            An email was sent to 
            <a href="#" class="text-decoration-none"><%= log.userEmail %></a>
            for <strong><%= log.purpose.replace('_', ' ') %></strong>.
          </p>

          <!-- Action Buttons -->
          <div class="d-flex gap-3 align-items-center">
            <!-- Delete Button -->
            <form action="/email-log/<%= log.id %>?_method=DELETE" method="POST" class="m-0 p-0">
              <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center">
                <i class="material-icons me-1" style="font-size: 18px;">delete</i> Delete
              </button>
            </form>

            <!-- View Button -->
            <a
              class="btn btn-sm btn-outline-secondary d-flex align-items-center"
              href="https://mail.google.com/"
              target="_blank"
            >
              <i class="material-icons me-1" style="font-size: 18px;">visibility</i> View
            </a>
          </div>
        </div>

      </div>
    </div>
  <% }); %>
</div>
<!-- footer  -->
    <%- include('../partials/footer') %>

  </body>

<!-- scripts  -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"
  ></script>

  <script
    src="https://kit.fontawesome.com/542d90fccf.js"
    crossorigin="anonymous"
  ></script>

</html>
