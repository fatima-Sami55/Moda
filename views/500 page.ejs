<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Internal Server Error — Moda'}) %>
  <body>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <style>
      :root {
        --bg-primary: #FAF9F6;
        --text-primary: #1A1A1A;
        --primary-accent: #FE672E;
        --secondary-accent: #6A69FF;
        --border-color: #1A1A1A;
        --font-heading: 'Unbounded', 'Outfit', sans-serif;
        --font-body: 'Inter', sans-serif;
      }

      body {
        background-color: var(--bg-primary) !important;
        color: var(--text-primary) !important;
        font-family: var(--font-body);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
      }

      .error-card {
        border: 3px solid var(--border-color) !important;
        border-radius: 0px !important;
        background: #FFFFFF !important;
        box-shadow: 8px 8px 0px var(--border-color) !important;
        padding: 24px 24px !important;
        text-align: center;
        max-width: 440px;
        width: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .error-card:hover {
        transform: translate(-2px, -2px);
        box-shadow: 10px 10px 0px var(--border-color) !important;
      }

      .error-icon {
        display: inline-block;
        margin-bottom: 12px;
        animation: pulse 2.5s infinite ease-in-out;
      }

      @keyframes pulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.06); }
      }

      .error-title {
        font-family: var(--font-heading) !important;
        font-weight: 900;
        font-size: clamp(0.95rem, 2.5vw, 1.2rem) !important;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        color: var(--text-primary) !important;
        margin-bottom: 12px !important;
      }

      .error-text {
        font-size: 0.84rem !important;
        line-height: 1.5;
        color: #666666 !important;
        max-width: 380px;
        margin: 0 auto 20px !important;
      }

      .btn-home {
        display: inline-block;
        background: var(--primary-accent) !important;
        border: 2.5px solid var(--border-color) !important;
        color: #FFFFFF !important;
        font-family: 'Outfit', sans-serif;
        font-weight: 800;
        font-size: 0.78rem !important;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 10px 24px !important;
        text-decoration: none !important;
        box-shadow: 4px 4px 0px var(--border-color) !important;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
      }

      .btn-home:hover {
        background: var(--secondary-accent) !important;
        color: #FFFFFF !important;
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0px var(--border-color) !important;
      }

      .btn-home:active {
        transform: translate(0px, 0px);
        box-shadow: none !important;
      }
    </style>

    <main class="card error-card">
      <div class="card-body p-0">
        <!-- Disconnected Server Stack Illustration (Redrawn SVG matching the theme) -->
        <div class="error-icon">
          <svg width="240" height="180" viewBox="0 0 280 200" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: 0 auto; filter: drop-shadow(3px 3px 0px rgba(0,0,0,0.05));">
            <defs>
              <!-- Glowing orange LED gradient -->
              <radialGradient id="orangeGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#FF9E79" />
                <stop offset="100%" stop-color="#FE672E" />
              </radialGradient>
            </defs>

            <!-- Ground Line and Dashed Accents -->
            <line x1="20" y1="170" x2="260" y2="170" stroke="var(--border-color)" stroke-width="3" stroke-linecap="round" />
            <line x1="45" y1="176" x2="70" y2="176" stroke="var(--border-color)" stroke-width="2" stroke-linecap="round" />
            <line x1="160" y1="176" x2="190" y2="176" stroke="var(--border-color)" stroke-width="2" stroke-linecap="round" />
            <line x1="215" y1="176" x2="235" y2="176" stroke="var(--border-color)" stroke-width="2" stroke-linecap="round" />

            <!-- RACK 4 (Bottom) -->
            <g class="rack-blade">
              <rect x="75" y="144" width="70" height="22" rx="4" fill="#333244" stroke="var(--border-color)" stroke-width="3" />
              <!-- Panel Inset -->
              <rect x="82" y="151" width="28" height="8" rx="2" fill="#1A1A1A" />
              <!-- Indicator Lights -->
              <circle cx="87" cy="148" r="1.5" fill="#FAF9F6" />
              <circle cx="93" cy="148" r="1.5" fill="#FAF9F6" />
              <circle cx="99" cy="148" r="1.5" fill="#FAF9F6" />
              <!-- Vents -->
              <rect x="115" y="149" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="119" y="149" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="123" y="149" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <!-- LED -->
              <circle cx="133" cy="155" r="3.5" fill="url(#orangeGlow)" stroke="var(--border-color)" stroke-width="1.5" />
            </g>

            <!-- RACK 3 -->
            <g class="rack-blade">
              <rect x="75" y="116" width="70" height="22" rx="4" fill="#333244" stroke="var(--border-color)" stroke-width="3" />
              <rect x="82" y="123" width="28" height="8" rx="2" fill="#1A1A1A" />
              <circle cx="87" cy="120" r="1.5" fill="#FAF9F6" />
              <circle cx="93" cy="120" r="1.5" fill="#FAF9F6" />
              <circle cx="99" cy="120" r="1.5" fill="#FAF9F6" />
              <rect x="115" y="121" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="119" y="121" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="123" y="121" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <circle cx="133" cy="127" r="3.5" fill="url(#orangeGlow)" stroke="var(--border-color)" stroke-width="1.5" />
            </g>

            <!-- RACK 2 -->
            <g class="rack-blade">
              <rect x="75" y="88" width="70" height="22" rx="4" fill="#333244" stroke="var(--border-color)" stroke-width="3" />
              <rect x="82" y="95" width="28" height="8" rx="2" fill="#1A1A1A" />
              <circle cx="87" cy="92" r="1.5" fill="#FAF9F6" />
              <circle cx="93" cy="92" r="1.5" fill="#FAF9F6" />
              <circle cx="99" cy="92" r="1.5" fill="#FAF9F6" />
              <rect x="115" y="93" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="119" y="93" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="123" y="93" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <circle cx="133" cy="99" r="3.5" fill="url(#orangeGlow)" stroke="var(--border-color)" stroke-width="1.5" />
            </g>

            <!-- RACK 1 (Top) -->
            <g class="rack-blade">
              <rect x="75" y="60" width="70" height="22" rx="4" fill="#333244" stroke="var(--border-color)" stroke-width="3" />
              <rect x="82" y="67" width="28" height="8" rx="2" fill="#1A1A1A" />
              <circle cx="87" cy="64" r="1.5" fill="#FAF9F6" />
              <circle cx="93" cy="64" r="1.5" fill="#FAF9F6" />
              <circle cx="99" cy="64" r="1.5" fill="#FAF9F6" />
              <rect x="115" y="65" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="119" y="65" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <rect x="123" y="65" width="2" height="11" rx="0.5" fill="var(--border-color)" />
              <circle cx="133" cy="71" r="3.5" fill="url(#orangeGlow)" stroke="var(--border-color)" stroke-width="1.5" />
            </g>

            <!-- Disconnected Power Cord -->
            <path d="M 145 127 C 165 127, 160 162, 175 162 C 185 162, 185 146, 185 140" fill="none" stroke="var(--border-color)" stroke-width="3" stroke-linecap="round" />

            <!-- Plug Body -->
            <g class="plug-head">
              <rect x="178" y="125" width="14" height="15" rx="3" fill="#EAF0F6" stroke="var(--border-color)" stroke-width="2.5" />
              <rect x="182" y="117" width="6" height="8" fill="var(--border-color)" />
              <!-- Two Pins -->
              <line x1="181" y1="140" x2="181" y2="147" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round" />
              <line x1="189" y1="140" x2="189" y2="147" stroke="var(--border-color)" stroke-width="2.5" stroke-linecap="round" />
            </g>

            <!-- Wall Socket -->
            <g class="wall-socket">
              <rect x="214" y="110" width="30" height="30" rx="4" fill="#FFFFFF" stroke="var(--border-color)" stroke-width="2.5" />
              <circle cx="229" cy="125" r="9" fill="#EAF0F6" stroke="var(--border-color)" stroke-width="1.5" />
              <circle cx="225" cy="125" r="1.5" fill="var(--border-color)" />
              <circle cx="233" cy="125" r="1.5" fill="var(--border-color)" />
            </g>

            <!-- Decorative Floating Symbols -->
            <!-- Yellow/Orange Lightning Bolt -->
            <path d="M 52 116 L 44 126 H 50 L 42 138" stroke="var(--primary-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />

            <!-- Orange Cross -->
            <path d="M 60 44 L 68 52 M 68 44 L 60 52" stroke="var(--primary-accent)" stroke-width="2.5" stroke-linecap="round" />

            <!-- Indigo Ring -->
            <circle cx="160" cy="50" r="4.5" stroke="var(--secondary-accent)" stroke-width="2.5" />

            <!-- Light Orange Plus -->
            <path d="M 195 90 L 203 90 M 199 86 L 199 94" stroke="var(--primary-accent)" stroke-width="2" stroke-linecap="round" />
          </svg>
        </div>

        <!-- Typography Heading -->
        <h2 class="error-title">500 — Server Collapse</h2>

        <!-- Description Paragraph -->
        <p class="error-text">
          Oops! Something went sideways on our end. Rest assured, our systems have flagged the anomaly, and our engineers are actively on the case. Please try again shortly.
        </p>

        <!-- CTA Home Button -->
        <a href="/home" class="btn-home">Return Home</a>
      </div>
    </main>
  </body>
</html>
