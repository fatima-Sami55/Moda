<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', {title: 'Moda'}) %>
  <body>
    <!-- stylesheets -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      href="//maxcdn.bootstrapcdn.com/font-awesome/4.1.0/css/font-awesome.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../css/inbox.css" />


<!-- Navbar -->
    <%- include('../partials/navbar-personal', { page: page }) %>
<!-- notification counter section  -->
  <div class="container" style="padding-top: 200px;">
        <% if ((notifications) > 0 ) { %>
          <button class="btn btn-danger" id="delete-all">
            Delete all notifications!
          </button>
          <% }%>
  <div class="row justify-content-center">
    <div class="col-12 col-sm-6 col-md-4 text-center">
        <div style="height: 50px"></div>
      <div class="counter-section text-center">
        <i class="material-icons medium-icon" aria-hidden="true"> notifications_active </i>
        <span class="counter" id="notification-count">
              <span
                class="timer counter alt-font appear"
                id="notification-count"
              ></span>
        <p class="counter-title">Total Notifications</p>
      </div>
    </div>
     </div>
  </div>
 </div>
<!-- notification display section -->
    <div id="notifications-container">
      <div class="notification-container">
        <div style="top: 50%; bottom: 50%">
          <div class="box">
            <article class="media">
              <div class="media-left">
                <figure class="image is-64x64">
                  <i
                    class="material-icons"
                    aria-hidden="true"
                    style="font-size: 50px; color: rgb(13, 14, 58)"
                    >notification_add</i
                  >
                </figure>
              </div>
              <div class="media-content">
                <div class="content">
                  <p>
                    <strong>loading............</strong>
                    <small>@ loading............</small>
                    <br />
                    loading............
                  </p>
                </div>
                <nav class="level is-mobile">
                  <div class="level-left">
                    <a
                      class="level-item delete-notification"
                      data-id=""
                      aria-label="delete"
                      title="Delete"
                      style="text-decoration: none; color: brown"
                    >
                      <i class="material-icons" aria-hidden="true">delete</i>
                    </a>
                    <a
                      href="/acessiories"
                      class="level-item"
                      aria-label="reply"
                      title="forward"
                      style="text-decoration: none; color: green"
                    >
                      <i class="material-icons" aria-hidden="true">forward</i>
                    </a>
                  </div>
                </nav>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  <!-- footer -->
    <%- include('../partials/footer') %>
<!-- loggedin user data -->
   <div
      id="loggedInUserData"
      data-first="<%= loggedInUser.firstname %>"
      data-last="<%= loggedInUser.lastname %>"
      data-id="<%= loggedInUser.id %>"
    ></div>

    </body>

 
<!-- scripts  -->

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
    <script>
      // Simple helper to escape HTML entities and prevent DOM XSS
      function escapeHTML(str) {
        if (!str) return "";
        return str
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      document.addEventListener("DOMContentLoaded", () => {
        const socket = io();
        const loggedInUserData = document.getElementById("loggedInUserData");
        const userId = loggedInUserData ? loggedInUserData.dataset.id : null;
        if (userId) {
          socket.emit("join", userId);
        }

        // Listen for 'notifications' event from server
        socket.on("notifications", (notifications) => {
          updateNotificationsUI(notifications);
        });

        function updateNotificationsUI(notifications) {
          const container = document.getElementById("notifications-container");
          container.innerHTML = ""; // Clear existing notifications
          const loggedInUserData = document.getElementById("loggedInUserData");
          const loggedInUser = {
            firstname: escapeHTML(loggedInUserData.dataset.first),
            lastname: escapeHTML(loggedInUserData.dataset.last),
          };
          notifications.forEach((notification) => {
            const notificationElement = document.createElement("div");
            notificationElement.className = "notification-container";
            notificationElement.innerHTML = `
          <div style="top: 50%; bottom: 50%">
            <div class="box">
              <article class="media">
                <div class="media-left">
                  <figure class="image is-64x64">
                    <i class="material-icons" aria-hidden="true" style="font-size: 50px; color: rgb(13, 14, 58)">notification_add</i>
                  </figure>
                </div>
                <div class="media-content">
                  <div class="content">
                    <p>
                      <strong>${loggedInUser.firstname} ${loggedInUser.lastname}</strong>
                      <small>@${loggedInUser.lastname}</small>
                      <br />
                      ${escapeHTML(notification.message)}
                    </p>
                  </div>
                  <nav class="level is-mobile">
                    <div class="level-left">
                      <a class="level-item delete-notification" data-id="${notification.id}" aria-label="delete" title="Delete" style="text-decoration: none; color: brown">
                        <i class="material-icons" aria-hidden="true">delete</i>
                      </a>
                      <a href="/acessiories" class="level-item" aria-label="reply" title="forward" style="text-decoration: none; color: green">
                        <i class="material-icons" aria-hidden="true">forward</i>
                      </a>
                    </div>
                  </nav>
                </div>
              </article>
            </div>
          </div>
        `;
            container.appendChild(notificationElement);
          });

          document.getElementById(
            "notification-count"
          ).textContent = `0${notifications.length}`;

          // Add event listener for delete-all button if it exists
          const deleteAllBtn = document.getElementById("delete-all");
          if (deleteAllBtn) {
            deleteAllBtn.addEventListener("click", function () {
              if (deleteAllBtn.disabled) return;
              deleteAllBtn.disabled = true;
              deleteAllBtn.textContent = 'Deleting...';
              fetch("/delete-all", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({ _csrf: "<%= csrfToken %>" }),
              })
                .then((response) => response.json())
                .then((data) => {
                  if (data.success) {
                    // Remove all notification containers
                    const notificationContainers = document.getElementsByClassName("notification-container");
                    while (notificationContainers.length > 0) {
                      notificationContainers[0].remove();
                    }
                    document.getElementById("notification-count").textContent = "00";
                  } else {
                    console.error("Failed to delete notification");
                    deleteAllBtn.disabled = false;
                    deleteAllBtn.textContent = 'Delete all notifications!';
                  }
                })
                .catch(() => {
                  deleteAllBtn.disabled = false;
                  deleteAllBtn.textContent = 'Delete all notifications!';
                });
            });
          }

          // Add event listeners for delete buttons
          document
            .querySelectorAll(".delete-notification")
            .forEach((button) => {
              button.addEventListener("click", function () {
                if (button.style.pointerEvents === 'none') return;
                button.style.pointerEvents = 'none';
                button.style.opacity = '0.4';
                const id = this.getAttribute("data-id");
                fetch("/delete-notification", {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                  },
                  body: JSON.stringify({ id, _csrf: "<%= csrfToken %>" }),
                })
                  .then((response) => response.json())
                  .then((data) => {
                    document.getElementById("notification-count").textContent =
                      data.notificationCount < 10 ? `0${data.notificationCount}` : `${data.notificationCount}`;
                    if (data.success) {
                      this.closest(".notification-container").remove();
                    } else {
                      console.error("Failed to delete notification");
                      button.style.pointerEvents = '';
                      button.style.opacity = '';
                    }
                  })
                  .catch(() => {
                    button.style.pointerEvents = '';
                    button.style.opacity = '';
                  });
              });
            });
        }
      });
    </script>

   <script src="/socket.io/socket.io.js"></script>

</html>
