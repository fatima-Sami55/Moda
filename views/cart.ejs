<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Moda - Shopping Cart'}) %>
  <!-- stylesheets -->
  <link href="/css/cart.css" rel="stylesheet" type="text/css" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
    crossorigin="anonymous"
  />
  <link
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css"
    rel="stylesheet"
  />
  <body>
    <!-- Navbar -->
    <%- include('../partials/navbar-carts', {page:page}) %>

    <!-- Neobrutalist Deletion Confirmation Overlay -->
    <div id="cart-confirm-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(31, 30, 35, 0.4); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); z-index: 10000; align-items: center; justify-content: center;">
      <div style="background: #FFFFFF; border: 3px solid #1F1E23; box-shadow: 8px 8px 0px #1F1E23; max-width: 480px; width: 100%; padding: 40px; text-align: center; border-radius: 0px;">
        <div style="width: 70px; height: 70px; background: #FFECEC; border: 3px solid #1F1E23; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 3px 3px 0px #1F1E23;">
          <i class="fa-regular fa-trash-can" style="font-size: 1.8rem; color: #6A69FF;"></i>
        </div>
        <h4 style="font-family: var(--font-heading), sans-serif; font-weight: 800; text-transform: uppercase; color: #1F1E23; font-size: 1.25rem; letter-spacing: 0.02em; margin-bottom: 12px;">Remove Item?</h4>
        <p style="font-family: var(--font-body), sans-serif; font-weight: 500; color: #555; font-size: 0.95rem; line-height: 1.6; margin-bottom: 30px;">Are you sure you want to remove this item from your shopping cart?</p>
        <div class="d-flex align-items-center justify-content-center gap-3">
          <button id="overlay-confirm-btn" class="btn px-4 py-2" style="background: #FE672E; color: #FFFFFF; border: 3px solid #1F1E23; font-family: var(--font-heading), sans-serif; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: 3px 3px 0px #1F1E23; border-radius: 0px; transition: all 0.15s ease;">Yes, Remove</button>
          <button id="overlay-cancel-btn" class="btn px-4 py-2" style="background: #FFFFFF; color: #1F1E23; border: 3px solid #1F1E23; font-family: var(--font-heading), sans-serif; font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; text-transform: uppercase; box-shadow: 3px 3px 0px #1F1E23; border-radius: 0px; transition: all 0.15s ease;">No, Keep It</button>
        </div>
      </div>
    </div>

    <% if (cartItems.length === 0) { %>
      <!-- Empty Cart -->
      <div class="container text-center cart-container-empty my-5">
        <div class="empty-cart-showcase">
          <img
            src="/image/vectors/empty-cart.svg"
            loading="lazy"
            width="280"
            height="240"
            alt="No items"
            class="img-fluid empty-cart-img smooth-image"
           
           
          />
          <h2 class="mt-4 empty-cart-heading">Your Cart is Empty</h2>
          <p class="empty-cart-sub">Looks like you haven't added anything to your cart yet.</p>
          <a href="/acessiories" class="btn btn-warning mt-3">
            <i class="fa fa-chevron-left me-2"></i> Shop Collection
          </a>
        </div>
      </div>
    <% } else { %>
      <!-- Cart with items -->
      <div class="container cart-container my-5">
        <h1 class="cart-main-title mb-4">Your Shopping Cart</h1>
        
        <div class="row g-5">
          <!-- Left Column: Products List -->
          <div class="col-12 col-lg-8">
            <div class="cart-items-wrapper">
              <% cartItems.forEach((item, index) => { %>
                <div class="product-card cart-item-card" data-id="<%= item.id %>" data-price="<%= item.item_price %>">
                  <div class="card-inner-layout">
                    <!-- Product Image Section -->
                    <div class="card-image-wrapper">
                      <img src="<%= item.item_img %>" loading="lazy" alt="<%= item.item_Name %>" class="product-card-img smooth-image" />
                      <span class="product-card-badge">MODA ORIGINAL</span>
                    </div>
                    
                    <!-- Product Details Section -->
                    <div class="card-info-wrapper">
                      <div class="info-header">
                        <h3 class="product-card-name"><%= item.item_Name %></h3>
                        <p class="product-card-desc text-truncate" title="<%= item.item_description %>">
                          <%= item.item_description %>
                        </p>
                      </div>
                      
                      <div class="price-info-row">
                        <div class="price-item">
                          <span class="price-label">Unit Price:</span>
                          <span class="unit-price">$<%= item.item_price %></span>
                        </div>
                        <div class="price-item">
                          <span class="price-label">Line Total:</span>
                          <span class="line-total item-subtotal">$0.00</span>
                        </div>
                      </div>
                    </div>

                    <!-- Actions Section -->
                    <div class="card-actions-wrapper">
                      <div class="quantity-counter-wrapper">
                        <button type="button" class="btn btn-qty-change btn-qty-minus" aria-label="Decrease quantity">−</button>
                        <input type="number" class="quantity-input" value="<%= item.quantity || 1 %>" min="1" max="20" readonly />
                        <button type="button" class="btn btn-qty-change btn-qty-plus" aria-label="Increase quantity">+</button>
                      </div>
                      
                      <form action="/delete/<%= item.id %>" method="POST" class="cart-delete-form m-0">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="button" class="btn-remove-item cart-remove-link" title="Remove Item">
                          <i class="fa-regular fa-trash-can"></i> Remove
                        </button>
                      </form>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- Right Column: Sidebar Order Summary -->
          <div class="col-12 col-lg-4">
            <div class="order-summary-card p-4">
              <h3 class="summary-title mb-4">Order Summary</h3>
              
              <div class="summary-row d-flex justify-content-between mb-3">
                <span class="summary-label">Subtotal</span>
                <span class="summary-val" id="summary-subtotal">$0.00</span>
              </div>
              

              <hr class="summary-divider my-4" />
              
              <div class="summary-row d-flex justify-content-between mb-4">
                <span class="summary-label-total">Total</span>
                <span class="summary-val-total" id="cart-total">$0.00</span>
              </div>
              
              <div class="summary-actions d-flex flex-column gap-3">
                <a href="/checkout" class="btn btn-success w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                  Proceed to Checkout <i class="fa fa-chevron-right"></i>
                </a>
                <a href="/acessiories" class="btn btn-warning w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                  <i class="fa fa-chevron-left"></i> Continue Shopping
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- scripts -->
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const cartCards = document.querySelectorAll(".cart-item-card");
        const csrfToken = "<%= csrfToken %>";

        function updateTotals() {
          let total = 0;
          const quantities = [];

          cartCards.forEach((card) => {
            const qtyInput = card.querySelector(".quantity-input");
            const price = parseFloat(card.getAttribute("data-price")) || 0;
            const quantity = parseInt(qtyInput.value) || 1;
            
            // Recalculate line total
            const lineTotal = price * quantity;
            const lineTotalEl = card.querySelector(".item-subtotal");
            if (lineTotalEl) {
              lineTotalEl.innerText = "$" + lineTotal.toFixed(2);
            }

            // Manage minus button state
            const minusBtn = card.querySelector(".btn-qty-minus");
            if (minusBtn) {
              if (quantity <= 1) {
                minusBtn.disabled = true;
              } else {
                minusBtn.disabled = false;
              }
            }

            total += lineTotal;
            quantities.push(quantity);
          });

          // Update sidebar order summary
          document.querySelectorAll("#cart-total").forEach((el) => {
            el.innerText = "$" + total.toFixed(2);
          });
          
          const subtotalEl = document.getElementById("summary-subtotal");
          if (subtotalEl) {
            subtotalEl.innerText = "$" + total.toFixed(2);
          }

          localStorage.setItem("cartTotal", total.toFixed(2));
          localStorage.setItem("quantities", JSON.stringify(quantities));
        }

        // Initialize and bind card events
        cartCards.forEach((card) => {
          const minusBtn = card.querySelector(".btn-qty-minus");
          const plusBtn = card.querySelector(".btn-qty-plus");
          const qtyInput = card.querySelector(".quantity-input");
          const itemId = card.getAttribute("data-id");

          function sendQuantityUpdate(newQty) {
            fetch("/cart/update-quantity", {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                itemId: itemId,
                quantity: newQty,
                _csrf: csrfToken
              })
            })
            .then(async (response) => {
              if (!response.ok) {
                const data = await response.json();
                console.error("Failed to update quantity:", data.error || "Server error");
                if (window.showToast) {
                  window.showToast(data.error || "Failed to update quantity.", "error");
                }
              }
            })
            .catch((err) => {
              console.error("AJAX Error:", err);
            });
          }

          minusBtn?.addEventListener("click", function () {
            let value = parseInt(qtyInput.value) || 1;
            if (value > 1) {
              qtyInput.value = value - 1;
              updateTotals();
              sendQuantityUpdate(value - 1);
            }
          });

          plusBtn?.addEventListener("click", function () {
            let value = parseInt(qtyInput.value) || 1;
            if (value < 20) {
              qtyInput.value = value + 1;
              updateTotals();
              sendQuantityUpdate(value + 1);
            }
          });
        });

        // Initial update
        updateTotals();

        // Soft confirmation overlay for removal
        let activeRemoveForm = null;
        const overlay = document.getElementById("cart-confirm-overlay");

        document.addEventListener("click", (event) => {
          const removeBtn = event.target.closest(".cart-remove-link");
          if (removeBtn) {
            event.preventDefault();
            activeRemoveForm = removeBtn.closest("form");
            overlay.style.display = "flex";
          }
        });

        document.getElementById("overlay-cancel-btn").addEventListener("click", () => {
          overlay.style.display = "none";
          activeRemoveForm = null;
        });

        document.getElementById("overlay-confirm-btn").addEventListener("click", () => {
          if (activeRemoveForm) {
            const confirmBtn = document.getElementById("overlay-confirm-btn");
            confirmBtn.disabled = true;
            confirmBtn.textContent = "Removing...";
            activeRemoveForm.submit();
          }
        });
      });
    </script>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>

    <%- include('../partials/footer') %>
  </body>
</html>
