<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Moda — Search Results'}) %>
  <body>

    <link href="/css/search.css" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />

    <%- include('../partials/navbar', { page: page }) %>

    <%
    searchResults.forEach(product => {
      /* pre-process for JS filtering */
    });
    %>

    <div class="search-page">
      <div class="container">

        <!-- ────────── HEADER ROW ────────── -->
        <div class="search-header">

          <!-- Title + chip — all inline -->
          <div class="search-title-block">
            <h1 class="search-result-title">
              Results for: <span class="search-query">"<%= query %>"</span>
              <% if (searchResults.length > 0) { %>
                <span class="result-count-chip"><%= searchResults.length %> found</span>
              <% } %>
            </h1>
          </div>

          <!-- Sort — client-side only, no page reload -->
          <div class="sort-form">
            <label for="sort" class="sort-label">Sort by</label>
            <select id="sort" class="sort-select">
              <option value="default"        <% if (sort === 'default')       { %>selected<% } %>>Default</option>
              <option value="price-low-high" <% if (sort === 'price-low-high'){ %>selected<% } %>>Price: Low → High</option>
              <option value="price-high-low" <% if (sort === 'price-high-low'){ %>selected<% } %>>Price: High → Low</option>
            </select>
          </div>

        </div><!-- /search-header -->

        <!-- ────────── TWO-COLUMN LAYOUT ────────── -->
        <div class="search-layout">

          <!-- ── FILTER SIDEBAR ── -->
          <aside class="filter-sidebar">
            <p class="filter-sidebar-title">Filters</p>

            <!-- Categories -->
            <div class="filter-group">
              <button class="filter-toggle-btn" data-target="filter-categories">
                <span class="filter-toggle-label">Categories</span>
                <span class="filter-icons">
                  <span class="plus-icon">+</span>
                  <span class="minus-icon">−</span>
                </span>
              </button>
              <div class="filter-panel" id="filter-categories">
                <% [['men','Men'],['women','Women'],['kids','Kids'],['acessiories','Accessories']].forEach(([val,label]) => { %>
                <label class="filter-item">
                  <input type="checkbox" name="category" value="<%= val %>">
                  <span><%= label %></span>
                </label>
                <% }) %>
              </div>
            </div>

            <!-- Styles -->
            <div class="filter-group">
              <button class="filter-toggle-btn" data-target="filter-styles">
                <span class="filter-toggle-label">Styles</span>
                <span class="filter-icons">
                  <span class="plus-icon">+</span>
                  <span class="minus-icon">−</span>
                </span>
              </button>
              <div class="filter-panel" id="filter-styles">
                <div class="filter-styles-grid">
                  <% ['casual','formal','vintage','traditional','costume','outdoor','sporty','classic'].forEach(s => { %>
                  <label class="filter-item">
                    <input type="checkbox" name="style" value="<%= s %>">
                    <span><%= s.charAt(0).toUpperCase()+s.slice(1) %></span>
                  </label>
                  <% }) %>
                </div>
              </div>
            </div>

            <!-- Price -->
            <div class="filter-group" style="border-bottom:none;">
              <button class="filter-toggle-btn" data-target="filter-price">
                <span class="filter-toggle-label">Price Range</span>
                <span class="filter-icons">
                  <span class="plus-icon">+</span>
                  <span class="minus-icon">−</span>
                </span>
              </button>
              <div class="filter-panel" id="filter-price">
                <% [['under50','Under $50'],['50to100','$50 – $100'],['100to200','$100 – $200'],['over200','Over $200']].forEach(([val,label]) => { %>
                <label class="filter-item">
                  <input type="radio" name="price" value="<%= val %>">
                  <span><%= label %></span>
                </label>
                <% }) %>
              </div>
            </div>

            <button class="clear-filters-btn">Clear All Filters</button>
          </aside>

          <!-- ── PRODUCTS GRID ── -->
          <div>
            <% if (searchResults.length > 0) { %>
            <div class="products-grid" id="p-card">
              <% searchResults.forEach(product => {
                const itemRating = (typeof ratingsMap !== 'undefined' && ratingsMap[product.name.toLowerCase().trim()]) || { avgRating: '0.0', totalReviews: 0 };
                const avg = parseFloat(itemRating.avgRating || 0);
              %>
              <div class="product-card" data-category="<%= product.categories %>" data-style="<%= product.style %>" data-price="<%= product.price %>">
                <div class="product-img-wrapper">
                  <img class="product-thumb smooth-image" src="<%= product.image %>" loading="lazy" width="220" height="240" alt="<%= product.name %>" />
                  <span class="product-badge"><%= product.categories %></span>
                </div>
                <div class="product-card-body">
                  <h5 class="product-brand"><%= product.name %></h5>
                  <p class="product-short-description"><%= product.description %></p>
                  <div class="price-rating-row">
                    <strong class="price">$<%= product.price %></strong>
                    <div class="search-stars card-rating-trigger" title="View reviews">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= Math.floor(avg)) { %><i class="fa fa-star"></i>
                        <% } else if (i - 0.5 <= avg) { %><i class="fa fa-star-half-o"></i>
                        <% } else { %><i class="fa fa-star-o"></i>
                        <% } %>
                      <% } %>
                      <span class="rating-count">(<%= itemRating.totalReviews %>)</span>
                    </div>
                  </div>
                  <a href="#" class="card-btn">View Piece</a>
                </div>
              </div>
              <% }) %>
            </div>
            <% } else { %>
            <div class="no-results">
              <div class="no-results-illustration">
                <img src="/image/vectors/no-results.svg" loading="lazy" width="140" height="140" alt="No Results Found" class="no-results-svg smooth-image" />
              </div>
              <h2 class="no-results-title">No Results Found</h2>
              <p class="no-results-sub">Try a different search term or adjust your filters.</p>
            </div>
            <% } %>
          </div>

        </div><!-- /search-layout -->
      </div><!-- /container -->
    </div><!-- /search-page -->

    <%- include('../partials/footer') %>

    <script>
      (function() {
        /* ================================================================
           SEARCH PAGE — Unified client-side: Sort + Filter + Clear
           All three controls read the same state and call applyAll()
         ================================================================ */

        // Parse original server data once, ensuring fallback
        var RAW_DATA = <%- JSON.stringify(searchResults) %> || [];

        /* ---- Render a single card ---- */
        function buildCard(p) {
          if (!p) return '';
          
          var avg = parseFloat(p.avgRating || 0);
          var stars = '';
          for (var i = 1; i <= 5; i++) {
            if      (i <= Math.floor(avg)) stars += '<i class="fa fa-star"></i>';
            else if (i - 0.5 <= avg)      stars += '<i class="fa fa-star-half-o"></i>';
            else                          stars += '<i class="fa fa-star-o"></i>';
          }

          // Escape double quotes inside values to avoid breaking rendered HTML
          var safeName = p.name ? String(p.name).replace(/"/g, '&quot;') : '';
          var safeDesc = p.description ? String(p.description).replace(/"/g, '&quot;') : '';
          var safeCategory = p.categories ? String(p.categories).toLowerCase().trim() : '';
          var safeStyle = p.style ? String(p.style).toLowerCase().trim() : '';
          var safePrice = p.price !== undefined && p.price !== null ? parseFloat(p.price) : 0;

          return `
            <div class="product-card" data-category="${safeCategory}" data-style="${safeStyle}" data-price="${safePrice}">
              <div class="product-img-wrapper">
                <img class="product-thumb smooth-image" src="${p.image || ''}" loading="lazy" width="220" height="240" alt="${safeName}" />
                <span class="product-badge">${p.categories || 'Item'}</span>
              </div>
              <div class="product-card-body">
                <h5 class="product-brand">${safeName}</h5>
                <p class="product-short-description">${safeDesc}</p>
                <div class="price-rating-row">
                  <strong class="price" data-price="${safePrice}">$${safePrice.toFixed(2)}</strong>
                  <div class="search-stars card-rating-trigger" title="View reviews">
                    ${stars}
                    <span class="rating-count">(${p.totalReviews || 0})</span>
                  </div>
                </div>
                <a href="#" class="card-btn">View Piece</a>
              </div>
            </div>`;
        }

        /* ---- Master function: reads sort + ALL filters, renders grid ---- */
        function applyAll() {
          // 1. Read sort option
          var sortEl = document.getElementById('sort');
          var sortVal = sortEl ? sortEl.value : 'default';

          // 2. Read category checkboxes
          var cats = [];
          document.querySelectorAll('input[name="category"]:checked').forEach(function(c) {
            cats.push(c.value.toLowerCase().trim());
          });

          // 3. Read style checkboxes
          var styles = [];
          document.querySelectorAll('input[name="style"]:checked').forEach(function(c) {
            styles.push(c.value.toLowerCase().trim());
          });

          // 4. Read price radio option
          var priceEl = document.querySelector('input[name="price"]:checked');
          var price   = priceEl ? priceEl.value.toLowerCase().trim() : null;

          // 5. Filter dataset
          var results = RAW_DATA.filter(function(p) {
            if (!p) return false;
            
            var pCategory = p.categories ? String(p.categories).toLowerCase().trim() : '';
            var pStyle = p.style ? String(p.style).toLowerCase().trim() : '';

            var matchCat   = !cats.length   || cats.indexOf(pCategory) !== -1;
            var matchStyle = !styles.length || styles.indexOf(pStyle) !== -1;
            var matchPrice = true;
            
            if (price) {
              var pr = parseFloat(p.price || 0);
              if (price === 'under50')  matchPrice = pr < 50;
              else if (price === '50to100')  matchPrice = pr >= 50 && pr <= 100;
              else if (price === '100to200') matchPrice = pr > 100 && pr <= 200;
              else if (price === 'over200')  matchPrice = pr > 200;
            }
            
            return matchCat && matchStyle && matchPrice;
          });

          // 6. Sort results
          if (sortVal === 'price-low-high') {
            results.sort(function(a, b) { return parseFloat(a.price || 0) - parseFloat(b.price || 0); });
          } else if (sortVal === 'price-high-low') {
            results.sort(function(a, b) { return parseFloat(b.price || 0) - parseFloat(a.price || 0); });
          }

          // 7. Update DOM Grid
          var grid = document.getElementById('p-card');
          if (!grid) {
            return;
          }

          // Update count chip
          var countChip = document.querySelector('.result-count-chip');
          if (countChip) {
            countChip.textContent = results.length + ' found';
          }

          if (!results.length) {
            grid.innerHTML = `
              <div class="no-results" style="grid-column: 1 / -1; width: 100%; box-sizing: border-box;">
                <div class="no-results-illustration">
                  <img src="/image/vectors/no-results.svg" loading="lazy" width="140" height="140" alt="No Results Found" class="no-results-svg smooth-image" />
                </div>
                <h2 class="no-results-title">No Results Found</h2>
                <p class="no-results-sub">Try adjusting your filters or clearing them.</p>
              </div>`;
            return;
          }

          grid.innerHTML = results.map(buildCard).join('');
        }

        // Expose functions globally immediately
        window.applyAll = applyAll;

        window.clearFilters = function() {
          // Uncheck every checkbox and radio button
          document.querySelectorAll('input[type="checkbox"], input[type="radio"]')
                  .forEach(function(i) { i.checked = false; });
          
          // Reset sort selector to default option
          var sortEl = document.getElementById('sort');
          if (sortEl) sortEl.value = 'default';
          
          // Re-evaluate filters and re-render
          applyAll();
        };

        // Initialize DOM-dependent listeners
        function initListeners() {
          /* ---- Accordion toggle ---- */
          document.querySelectorAll('.filter-toggle-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var targetId = btn.dataset.target;
              var panel  = document.getElementById(targetId);
              if (!panel) return;
              
              var isOpen = panel.classList.contains('open');

              // Close all panels first to maintain accordion-like clean sidebar
              document.querySelectorAll('.filter-panel').forEach(function(p) { p.classList.remove('open'); });
              document.querySelectorAll('.filter-toggle-btn').forEach(function(b) { b.classList.remove('open'); });

              // Open the clicked panel if it was closed
              if (!isOpen) {
                panel.classList.add('open');
                btn.classList.add('open');
              }
            });
          });

          /* ---- Sort dropdown change listener ---- */
          var sortEl = document.getElementById('sort');
          if (sortEl) {
            sortEl.addEventListener('change', applyAll);
          }

          /* ---- Sidebar filters change listeners ---- */
          document.querySelectorAll('.filter-sidebar input').forEach(function(input) {
            input.addEventListener('change', applyAll);
          });

          /* ---- Clear filters button click listener ---- */
          var clearBtn = document.querySelector('.clear-filters-btn');
          if (clearBtn) {
            clearBtn.addEventListener('click', clearFilters);
          }

          /* ---- Navigate to product page (event delegation, survives re-render) ---- */
          document.addEventListener('click', function(e) {
            var btn  = e.target.closest('.card-btn');
            var star = e.target.closest('.card-rating-trigger');
            var card = (btn || star) ? (btn || star).closest('.product-card') : null;
            if (!card) return;
            e.preventDefault();

            var nameEl = card.querySelector('.product-brand');
            var name   = nameEl ? nameEl.innerText.trim() : '';

            var imgEl = card.querySelector('.product-thumb');
            var img   = imgEl ? imgEl.src : '';

            var descEl = card.querySelector('.product-short-description');
            var desc   = descEl ? descEl.innerText.trim() : '';

            var priceEl = card.querySelector('.price');
            var price   = priceEl ? priceEl.innerText.replace('$', '').trim() : '';

            var url = new URL('/Product', window.location.origin);
            url.searchParams.set('name',  name);
            url.searchParams.set('img',   img);
            url.searchParams.set('desc',  desc);
            url.searchParams.set('price', price);
            window.location.href = url.toString() + (star ? '#reviews' : '');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initListeners);
        } else {
          initListeners();
        }
      })();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"></script>
  </body>
</html>
