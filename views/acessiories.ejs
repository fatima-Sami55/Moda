  <!-- code for baner image-->    
    <div class="banner">
      <div class="content">
        <div class="banner-content">
          <div class="banner-text">
            <!-- Capsule Pill Badge -->
            <div class="capsule-badge-row">
              <span class="capsule-pill">ACCESSORIES</span>
            </div>
            <h2>VISIT OUR TOP<br><span class="outlined-word">ACCESSORIES</span></h2>
            <p class="banner-desc">
             Discover the perfect accents to elevate your style at our Accessories collection. From timeless classics to the latest trends, explore an array of pieces that effortlessly complement every outfit, ensuring you stand out.
            </p>
            <div>
              <a href="#shoes" class="browse-btn">
                Browse!
              </a>
            </div>
          </div>
          <div class="banner-image-container">
            <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?q=80&w=800&auto=format&fit=crop" loading="lazy" width="480" height="360" alt="Accessories Showcase" class="banner-image smooth-image" />
            <!-- Rotating Circle Sticker Overlay -->
            <div class="summer-sale-sticker">
              <div class="sticker-inner">
                <span class="sticker-tag" style="color: var(--secondary-accent) !important;">COLLECTION</span>
                <span class="sticker-discount" style="color: var(--primary-accent) !important;">HOT</span>
                <span class="sticker-tag" style="color: var(--text-primary) !important;">ACESS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

<!-- code for shoes segment-->
<div id="shoes"></div>

<section class="product py-5">
  <div class="container">
    <div class="category-header">
      <h2 class="product-category">Shoes</h2>
      <div class="category-divider"></div>
    </div>
    <div class="row g-5 align-items-stretch">
      <% data.shoes.forEach(shoe => { %>
        <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4 d-flex">
          <div class="product-card w-100 d-flex flex-column justify-content-between">
            <div class="product-image">
              <span class="discount-tag">50% off</span>
              <img src="<%= shoe.image %>" loading="lazy" width="240" height="180" class="product-thumb smooth-image" alt="<%= shoe.name %>" />
            </div>
            <div class="product-info">
              <h5 class="product-brand"><%= shoe.name %></h5>
              <p class="product-short-description"><%= shoe.description %></p>
              <span class="price">$<%= shoe.price %></span>
              <a href="/Product" class="card-btn">View product here!</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>

