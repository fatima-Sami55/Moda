<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', {title: 'Moda'}) %>
  <body>
    <!-- stylesheets -->
    <link rel="stylesheet" href="../css/review.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bulma@0.9.3/css/bulma.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />

<!-- Navbar -->
<%- include('../partials/navbar-personal', { page: page }) %>
<!-- review counter section  -->
  <div class="container" style="padding-top: 200px;">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-6 col-md-4 text-center">
      <div class="counter-section">
        <i class="material-icons" aria-hidden="true" style="font-size: 25px;">rate_review</i>
         <span class="timer counter alt-font appear" id="notification-count">0<%=reviewCount  %></span>
        <p class="counter-title">Total Reviews</p>
      </div>
    </div>
  </div>
 </div>
<!-- review display section -->
<div class="container py-4">
  <% review.forEach(item => { %>
    <div class="review-item card mb-4" id="review-container-<%= item.id %>" data-purchasedItemId="<%= item.purchasedItemId %>">
      <div class="card-body">
        <div class="d-flex flex-column flex-md-row align-items-center">
          <!-- Product Image -->
          <div class="me-md-4 mb-3 mb-md-0 text-center align-self-start">
            <img src="<%= item.item_img %>" alt="Image" class="img-fluid rounded" style="max-width: 100px; margin-top: -10px;">
          </div>

          <!-- Product Info and Review -->
          <div class="flex-grow-1 w-100">
           <!-- Rating -->
                   <form class="rating" style="float: right;">
            <label>
              <input type="radio" name="stars-<%= item.id %>" value="1" checked/>
              <span class="icon">★</span>
            </label>
            <label>
              <input type="radio" name="stars-<%= item.id %>" value="2" />
              <span class="icon">★</span>
              <span class="icon">★</span>
            </label>
            <label>
              <input type="radio" name="stars-<%= item.id %>" value="3" />
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
            </label>
            <label>
              <input type="radio" name="stars-<%= item.id %>" value="4" />
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
            </label>
            <label>
              <input type="radio" name="stars-<%= item.id %>" value="5" />
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
              <span class="icon">★</span>
            </label>
          </form>
          <p style="float: right; padding-right: 5px">Rate this product:</p>

            <!-- Product Details -->
            <div class="mb-2">
              <strong id="productName-<%= item.id %>"><%= item.itemName %></strong>
              <h6 class="text-muted mb-1"><%= item.itemDescription %></h6>
              <small><strong>Order ID:</strong> <%= item.id %></small>
            </div>

            <!-- Review Text Area -->
             <div class="needs-validation review-form  input-group mb-3"  novalidate>
              <span for="review-<%= item.id %>" class="input-group-text">Write your review</span>
              <textarea class="form-control review-input" aria-label="With textarea" id="review-<%= item.id %>" required minlength="12" rows="2"></textarea>
               <div class="invalid-feedback">
                  Please write at least 12 characters.
                </div>
                </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3">
              <button type="button" class="btn btn-outline-danger btn-delete" data-id="<%= item.id %>">
                <i class="material-icons">delete</i>
              </button>
              <button type="button" class="btn btn-outline-success btn-submit" data-id="<%= item.id %>">
                <i class="material-icons">check_circle</i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Hidden purchase id -->
      <div class="purchaseid" data-id="<%= item.purchase_id %>"></div>
    </div>
  <% }) %>
</div>
<!--  footer  -->
   <%- include('../partials/footer') %>

  </body>

<!-- scripts  -->

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"
  ></script>

<script>
  document.querySelectorAll('.btn-delete').forEach(button => {
    button.addEventListener('click', async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      const orderId = button.getAttribute('data-id');
      // Find the closest review item and get its purchaseid
      const reviewItem = button.closest('.review-item');
      const purchasedItemId = reviewItem ? reviewItem.getAttribute('data-purchasedItemId') : null;
      const purchaseidDiv = reviewItem ? reviewItem.querySelector('.purchaseid') : null;
      const purchaseid = purchaseidDiv ? purchaseidDiv.getAttribute('data-id') : null;

      const originalHTML = button.innerHTML;
      button.disabled = true;
      button.innerHTML = '<i class="material-icons fa-spin">hourglass_empty</i>';

      const response = await fetch('/review', {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ orderId, purchasedItemId, purchaseid, _csrf: "<%= csrfToken %>" })
      });

      if (response.ok) {
        window.location.href = '/review';
      } else {
        button.disabled = false;
        button.innerHTML = originalHTML;
      }
    });
  });
</script>


<script>
  (function () {
    "use strict";

    const minReviewLength = 12;

    document.querySelectorAll(".review-item").forEach((reviewCard) => {
      const textarea = reviewCard.querySelector(".review-input");
      const submitBtn = reviewCard.querySelector(".btn-submit");
      const feedback = reviewCard.querySelector(".invalid-feedback");
      const wrapper = reviewCard.querySelector(".review-form");
      

      submitBtn.addEventListener("click", async function (e) {
        e.preventDefault();
        if (submitBtn.disabled) return;

        const reviewText = textarea.value.trim();

        // Validation check
        if (reviewText.length < minReviewLength) {
          textarea.classList.add("is-invalid");
          textarea.classList.remove("is-valid");
          return;
        }

        textarea.classList.remove("is-invalid");
        textarea.classList.add("is-valid");

        const originalHTML = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="material-icons">hourglass_empty</i>';

        // Prepare submission data
        const id = this.dataset.id;
        const rating = reviewCard.querySelector(`input[name="stars-${id}"]:checked`)?.value;
        const productName = document.getElementById(`productName-${id}`)?.textContent || "";
        const purchaseid = document.getElementById("purchaseid")?.getAttribute("data-id");
        const purchasedItemId = reviewCard.getAttribute("data-purchasedItemId");

        try {
          const response = await fetch("/review", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              review: reviewText,
              rating: rating,
              id: id,
              productName: productName,
              purchaseid: purchaseid,
              purchasedItemId: purchasedItemId,
              _csrf: "<%= csrfToken %>"
            })
          });

          if (response.ok) {
            window.location.href = "/review";
          } else {
            console.error("❌ Server error: Review not submitted!");
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHTML;
          }
        } catch (err) {
          console.error("❌ Network error:", err);
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalHTML;
        }
      });
    });
  })();
</script>



</html>
