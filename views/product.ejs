<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head', {title: 'Moda'}) %>
  
  <body>
    <!-- stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css" integrity="sha512-MV7K8+y+gLIBoVD59lQIYicR65iaqukzvf/nwasF0nqhPay5w/9lJmVM2hMDcnK1OnMGCdVK+iQrJ7lzPJQd1w==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="/css/product.css" rel="stylesheet" type="text/css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

<!-- Navbar -->
    <%- include('../partials/navbar', { page: page }) %>
<!-- Product Card + Rating + Review Section -->
    <div class="main-card container pt-0 pb-5">
      <div class="row g-5 align-items-center">
        <!-- Left Column: Large Image Showcase Container -->
        <div class="col-12 col-lg-6">
          <div class="modern-product-image-container">
            <!-- Status Badge overlapping the image top-left -->
            <div class="purchase-status-badge">
              <span><%= purchasesCount %> Purchased</span>
            </div>
            <img src="<%= data.itemImage %>" loading="lazy" width="500" height="500" alt="<%= data.itemName %>" class="img img-fluid modern-product-image smooth-image" />
          </div>
        </div>

        <!-- Right Column: Premium Details & Call-To-Actions -->
        <div class="col-12 col-lg-6">
          <div class="modern-product-details">
            <div class="capsule-badge-row">
              <span class="capsule-pill">HOT ITEM</span>
            </div>
            <h1 class="modern-product-title card-title"><%= data.itemName %></h1>

            <!-- Ratings Summary -->
            <% 
              let topAvgRating = parseFloat(avgRating || 0);
              let topTotalReviews = parseInt(totalReviews || 0);
            %>
            <a href="#reviews" class="d-flex align-items-center mb-3" style="text-decoration: none; color: inherit; width: fit-content;" title="Scroll to reviews">
              <div class="me-2" style="font-size: 1.2rem; line-height: 1;">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= Math.floor(topAvgRating)) { %>
                    <i class="fa fa-star schriftorange"></i>
                  <% } else if (i - 0.5 <= topAvgRating) { %>
                    <i class="fa fa-star-half-o schriftorange"></i>
                  <% } else { %>
                    <i class="fa fa-star-o text-muted"></i>
                  <% } %>
                <% } %>
              </div>
              <span class="text-muted" style="font-size: 0.90rem; line-height: 1; margin-left: 5px;">(<%= topTotalReviews %> customer reviews)</span>
            </a>

            <!-- Price block -->
            <div class="modern-price-block mb-4">
              <span class="modern-price-tag card-price">$<%= data.itemPrice %></span>
            </div>

            <hr class="divider-line my-4" />

            <!-- Product Description Sub-Section -->
            <h3 class="modern-sub-title">Product Details</h3>
            <p class="modern-product-desc card-text mb-4"><%= data.itemDescription %></p>

            <hr class="divider-line my-4" />

            <!-- Call-To-Action Operations -->
            <div class="modern-actions-row d-flex align-items-center gap-3">
              <% if (isLoggedIn) { %>
                <button class="btn-cart modern-cta-btn add-to-cart-cta flex-grow-1">
                  Add to Cart <i class="fa fa-shopping-cart ms-2"></i>
                </button>
                <button class="btn-wish modern-cta-btn wishlist-cta">
                  Wishlist <i class="fa fa-heart ms-2"></i>
                </button>
              <% } else { %>
                <a href="/protected" class="modern-cta-btn add-to-cart-cta text-decoration-none flex-grow-1 text-center">
                  Add to Cart <i class="fa fa-shopping-cart ms-2"></i>
                </a>
                <a href="/protected" class="modern-cta-btn wishlist-cta text-decoration-none text-center">
                  Wishlist <i class="fa fa-heart ms-2"></i>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ratings & Reviews Container -->
    <div class="container pb-5">
      <% 
        let finalAvgRating = typeof avgRating !== 'undefined' ? avgRating : '0.0';
        let finalTotalReviews = typeof totalReviews !== 'undefined' ? totalReviews : 0;
        let finalRatings = ratings;
        let isRatingsDummy = false;

        if (parseInt(finalTotalReviews) === 0) {
          isRatingsDummy = true;
          finalAvgRating = '4.5';
          finalTotalReviews = 20;
          finalRatings = [
            { stars: 5, count: 60, displayCount: 12 }, // 60%
            { stars: 4, count: 25, displayCount: 5 },  // 25%
            { stars: 3, count: 10, displayCount: 2 },  // 10%
            { stars: 2, count: 5, displayCount: 1 },   // 5%
            { stars: 1, count: 0, displayCount: 0 }    // 0%
          ];
        }
      %>

      <!-- Ratings Section -->
      <div class="row">
        <div class="col-12 product-page-section">
          <div class="modern-details-card p-4 p-md-5 graph-star-rating">
            <!-- Ratings Breakdown Sub-section -->
            <h2 class="modern-sub-title-large" style="margin-bottom: 30px;">Customer Rating</h2>

            <% if (isRatingsDummy) { %>
              <div class="alert alert-info py-2 px-3 mb-4 rounded-0" style="background-color: #FFF5EA !important; border: 2px solid var(--text-primary) !important; color: var(--text-primary) !important; font-family: var(--font-body); font-weight: 500; font-size: 0.9rem;">
                <i class="fa fa-info-circle me-2"></i><strong>Demo Mode:</strong> Displaying example customer ratings breakdown. Real customer reviews will automatically update these.
              </div>
            <% } %>
            
            <div class="row mt-4 align-items-center">
              <!-- Rating Summary Box (Left) -->
              <div class="col-12 col-md-4 text-center mb-4 mb-md-0">
                <div class="modern-rating-summary-box">
                  <h1 class="modern-rating-score"><%= parseFloat(finalAvgRating).toFixed(1) %></h1>
                  <div style="font-size: 1.4rem; line-height: 1;">
                    <% const avgBreakdown = parseFloat(finalAvgRating); %>
                    <% for (let i = 1; i <= 5; i++) { %>
                      <% if (i <= Math.floor(avgBreakdown)) { %>
                        <i class="fa fa-star schriftorange"></i>
                      <% } else if (i - 0.5 <= avgBreakdown) { %>
                        <i class="fa fa-star-half-o schriftorange"></i>
                      <% } else { %>
                        <i class="fa fa-star-o text-muted"></i>
                      <% } %>
                    <% } %>
                  </div>
                  <p class="text-muted mb-0" style="font-size: 0.95rem; font-family: var(--font-body);">Based on <%= finalTotalReviews %> customer reviews</p>
                </div>
              </div>

              <!-- Rating Breakdown Progress Bars (Right) -->
              <div class="col-12 col-md-8">
                <div class="modern-rating-bars-container d-flex flex-column gap-3">
                  <% finalRatings.forEach(r => { %>
                    <div class="rating-view d-flex align-items-center gap-3">
                      <span class="sternzahl" style="min-width: 80px; font-weight: 700; color: var(--text-primary); font-family: var(--font-body);"><%= r.stars %> Stars</span>
                      <div class="skill flex-grow-1">
                        <div class="rating-bar" style="background: rgba(26, 26, 26, 0.06) !important; border: 2px solid var(--text-primary) !important; height: 12px; overflow: hidden; border-radius: 0px;">
                          <div style="width: <%= r.count %>%; height: 100%; background: var(--primary-accent) !important;"></div>
                        </div>
                      </div>
                      <span class="zahlreviews text-center" style="min-width: 50px; padding: 4px 8px; border: 2px solid var(--text-primary); background: #FFFFFF; font-weight: 700; font-size: 0.85rem; font-family: var(--font-body); border-radius: 0px !important;"><%= parseInt(typeof r.displayCount !== 'undefined' ? r.displayCount : r.count) %></span>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="row">
        <div class="col-12 product-page-section" id="reviews">
          <div class="modern-details-card p-4 p-md-5 restaurant-detailed-ratings-and-reviews">
            <h2 class="modern-sub-title-large" style="margin-bottom: 30px;">Customer Reviews</h2>

            <% 
              let displayReviews = [];
              let isDummy = false;
              if (typeof dbReviews !== 'undefined' && dbReviews.length > 0) {
                displayReviews = dbReviews;
              } else {
                isDummy = true;
                displayReviews = [
                  {
                    firstname: "Marcus",
                    lastname: "Vance",
                    rating: 5,
                    review: "Absolutely insane quality. The high-top ankle support is super sturdy, and the materials feel extremely premium. The details look so futuristic in person. Definitely copping the other colorways.",
                    img: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=150&auto=format&fit=crop"
                  },
                  {
                    firstname: "Elena",
                    lastname: "Rostova",
                    rating: 4,
                    review: "Very comfortable for daily wear and look extremely polished. Spacing is perfect. The only minor thing is they run slightly large, so maybe size down by half. Aside from that, 10/10 streetwear aesthetic.",
                    img: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=150&auto=format&fit=crop"
                  }
                ];
              }
            %>

            <% if (isDummy) { %>
              <div class="alert alert-info py-2 px-3 mb-4 rounded-0" style="background-color: #FFF5EA !important; border: 2px solid var(--text-primary) !important; color: var(--text-primary) !important; font-family: var(--font-body); font-weight: 500; font-size: 0.9rem;">
                <i class="fa fa-info-circle me-2"></i><strong>Demo Mode:</strong> Displaying example customer reviews to demonstrate styling. Real reviews will automatically replace these.
              </div>
            <% } %>

            <% displayReviews.forEach(r => { %>
              <div class="reviews-members pt-4 pb-4 border-bottom review-item" style="border-color: rgba(26, 26, 26, 0.12) !important;">
                <div class="d-flex">
                  <img src="<%= r.img || 'http://bootdey.com/img/Content/avatar/avatar1.png' %>" loading="lazy" width="55" height="55" alt="Avatar" class="mr-3 rounded-pill reviews-members-avatar smooth-image" style="width: 55px; height: 55px; object-fit: cover; border: 2px solid var(--text-primary) !important; box-shadow: 2px 2px 0px var(--text-primary);">
                  <div class="media-body ms-3 w-100">
                    <div class="reviews-members-header d-flex justify-content-between align-items-center">
                      <h6 class="mb-0"><span class="text-black fw-bold" style="font-family: var(--font-body); font-size: 1.1rem;"><%= r.firstname %> <%= r.lastname %></span></h6>
                      <span class="star-rating" style="font-size: 1.1rem;">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="fas fa-star <%= i <= r.rating ? 'schriftorange' : 'text-muted' %>"></i>
                        <% } %>
                      </span>
                    </div>
                    <div class="reviews-members-body mt-2">
                      <p class="text-black mb-0" style="font-family: var(--font-body); font-size: 0.98rem; line-height: 1.65; color: var(--text-secondary) !important;"><%= r.review %></p>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
<!-- Related products section -->
   <section class="related-products py-5">
      <div class="container px-4 px-lg-5 mt-5">
        <h2 class="modern-sub-title-large" style="margin-bottom: 8px;">Related products</h2>
        <div class="category-divider"></div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-5 justify-content-center align-items-stretch">
          <% 
            // Combine all related product groups
            let allRelated = [
              ...randomData1Products,
              ...randomData3Products,
              ...randomData4Products
            ];
            for (const cat in randomData2Products) {
              allRelated.push(...randomData2Products[cat]);
            }
            
            // Deduplicate items, and filter out the current active viewed product
            let uniqueRelated = [];
            let seenNames = new Set();
            const currentName = data.itemName.toLowerCase().trim();
            seenNames.add(currentName);

            allRelated.forEach(p => {
              const nameLower = p.name.toLowerCase().trim();
              if (!seenNames.has(nameLower)) {
                seenNames.add(nameLower);
                uniqueRelated.push(p);
              }
            });

            // Slice to exactly 9 products for clean tucked 3-row presentation
            let finalRelatedList = uniqueRelated.slice(0, 9);
          %>

          <% finalRelatedList.forEach(product => { %>
            <div class="col mb-5 card-recommended d-flex">
              <div class="product-card w-100 d-flex flex-column justify-content-between">
                <span class="badge-best-selling">Recommended</span>
                <div class="product-image">
                  <img src="<%= product.image %>" loading="lazy" width="220" height="160" class="product-thumb img smooth-image" alt="<%= product.name %>" />
                </div>
                <div class="product-info">
                  <h4 class="product-brand card-title"><%= product.name %></h4>
                  <p class="product-short-description card-text"><%= product.description %></p>
                  
                  <div class="text-warning mb-2 card-rating-trigger" style="font-size: 0.95rem; cursor: pointer;" title="View reviews">
                    <% const itemRating = (typeof ratingsMap !== 'undefined' && ratingsMap[product.name.toLowerCase().trim()]) || { avgRating: '0.0', totalReviews: 0 }; %>
                    <% const avg = parseFloat(itemRating.avgRating || 0); %>
                    <% for (let i = 1; i <= 5; i++) { %>
                      <% if (i <= Math.floor(avg)) { %>
                        <i class="fa fa-star schriftorange"></i>
                      <% } else if (i - 0.5 <= avg) { %>
                        <i class="fa fa-star-half-o schriftorange"></i>
                      <% } else { %>
                        <i class="fa fa-star-o text-muted"></i>
                      <% } %>
                    <% } %>
                    <span class="text-muted ms-1" style="font-size: 0.75rem;">(<%= itemRating.totalReviews %>)</span>
                  </div>

                  <span class="price card-price">$<%= product.price %></span>
                  <a href="#" class="card-btn">View Product</a>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </section>
<!-- Footer section -->
    <%- include('../partials/footer') %>
    
  </body>

<!-- scripts -->



  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
    crossorigin="anonymous"
  ></script>

  <!-- Brutalist Lookbook Toast Notification Script -->
  <script>
    function showLookbookToast(title, message, isError = false) {
      // Find or create toast element
      let toast = document.querySelector('.lookbook-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.className = 'lookbook-toast';
        document.body.appendChild(toast);
      }
      
      toast.innerHTML = `
        <div class="lookbook-toast-icon ${isError ? 'error' : ''}">
          <span>${isError ? '✕' : '✓'}</span>
        </div>
        <div class="lookbook-toast-content">
          <div class="lookbook-toast-title">${title}</div>
          <p class="lookbook-toast-message">${message}</p>
        </div>
      `;
      
      // Force reflow/repaint
      toast.offsetHeight;
      
      // Slide in
      toast.classList.add('show');
      
      // Dismiss after 3.2 seconds
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3200);
    }
  </script>

  <!-- Add to Cart Click Handler with Sleek Toast Feedback -->
  <script>
    document.querySelectorAll('.btn-cart').forEach(button => {
      button.addEventListener('click', async (event) => {
        if (button.disabled) return;
        const originalHTML = button.innerHTML;
        button.disabled = true;
        button.style.opacity = '0.7';
        button.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Adding...';
        try {
          const itemNameElements = document.getElementsByClassName('card-title');
          const itemImageElements = document.getElementsByClassName('img');
          const itemDescriptionElements = document.getElementsByClassName('card-text');
          const itemPriceElements = document.getElementsByClassName('card-price');
    
          let itemName, itemImage, itemDescription, itemPrice;
    
          if (itemNameElements.length > 0 && itemImageElements.length > 0 && itemDescriptionElements.length > 0 && itemPriceElements.length > 0) {
            itemName = itemNameElements[0].innerText.trim();
            itemImage = itemImageElements[0].src;
            itemDescription = itemDescriptionElements[0].innerText.trim();
            itemPrice = itemPriceElements[0].innerText.replace('$', '').trim();
          } else {
            showLookbookToast('Error', 'Product elements not found on the page.', true);
            button.disabled = false;
            button.style.opacity = '';
            button.innerHTML = originalHTML;
            return;
          }
    
          const response = await fetch('/add-to-cart', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
              itemName,
              itemImage,
              itemDescription,
              itemPrice,
              _csrf: "<%= csrfToken %>"
            })
          });
    
          if (response.ok) {
            const data = await response.json(); 
            showLookbookToast('Added to Cart', `${itemName} was successfully added to your shopping cart.`);
            button.innerHTML = '<i class="fa fa-check me-2"></i> Added!';
            setTimeout(() => { button.disabled = false; button.style.opacity = ''; button.innerHTML = originalHTML; }, 2000);
          } else {
            const errorData = await response.json().catch(() => ({}));
            showLookbookToast('Failed to Add', `${errorData.error || errorData.message || 'Unable to add item to cart.'}`, true);
            button.disabled = false;
            button.style.opacity = '';
            button.innerHTML = originalHTML;
          }
        } catch (error) {
          console.error('Error:', error);
          showLookbookToast('Connection Error', 'Failed to connect to checkout database.', true);
          button.disabled = false;
          button.style.opacity = '';
          button.innerHTML = originalHTML;
        }
      });
    });
  </script>    
  
  <!-- Wishlist Click Handler with Sleek Toast Feedback -->
  <script>
    document.querySelectorAll('.btn-wish').forEach(button => {
      button.addEventListener('click', async (event) => {
        if (button.disabled) return;
        const originalHTML = button.innerHTML;
        button.disabled = true;
        button.style.opacity = '0.7';
        button.innerHTML = '<i class="fa fa-spinner fa-spin me-2"></i> Saving...';
        try {
          const itemNameElements = document.getElementsByClassName('card-title');
          const itemImageElements = document.getElementsByClassName('img');
          const itemDescriptionElements = document.getElementsByClassName('card-text');
          const itemPriceElements = document.getElementsByClassName('card-price')
 
          let itemName, itemImage, itemDescription, itemPrice, currentDate;
    
          if (itemNameElements.length > 0 && itemImageElements.length > 0 && itemDescriptionElements.length > 0 && itemPriceElements.length > 0) {
            itemName = itemNameElements[0].innerText.trim();
            itemImage = itemImageElements[0].src;
            itemDescription = itemDescriptionElements[0].innerText.trim();
            itemPrice = itemPriceElements[0].innerText.replace('$', '').trim();
            currentDate = new Date().toDateString();
          } else {
            showLookbookToast('Error', 'Product elements not found on the page.', true);
            button.disabled = false;
            button.style.opacity = '';
            button.innerHTML = originalHTML;
            return;
          }
  
          const response = await fetch('/wish', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
              itemName,
              itemImage,
              itemDescription,
              itemPrice,
              currentDate,
              _csrf: "<%= csrfToken %>"
            })
          });
  
          if (response.ok) {
            showLookbookToast('Saved to Wishlist', `${itemName} has been added to your wishlist.`);
            setTimeout(() => {
              window.location.href = '/wish';
            }, 1400);
          } else {
            const errorData = await response.json().catch(() => ({}));
            showLookbookToast('Already Saved', `${errorData.error || errorData.message || 'This item is already in your wishlist.'}`, true);
            button.disabled = false;
            button.style.opacity = '';
            button.innerHTML = originalHTML;
          }
        } catch (error) {
          console.error('Error:', error);
          showLookbookToast('Connection Error', 'Failed to connect to wishlist database.', true);
          button.disabled = false;
          button.style.opacity = '';
          button.innerHTML = originalHTML;
        }
      });
    });
  </script>

 <script>
  document.querySelectorAll(".card-btn").forEach((button) => {
     button.addEventListener("click", (event) => {
    const productCard = event.target.closest(".card-recommended");
    if (!productCard) return;

    const itemName = productCard.querySelector(".card-title").innerText.trim();
    const itemImage = productCard.querySelector(".img").src;
    const itemDescription = productCard.querySelector(".card-text").innerText.trim();
    const itemPrice = productCard.querySelector(".card-price").innerText.replace("$", "").replace("View product", "").trim();

    // Build URL with query params
    const url = new URL("/Product", window.location.origin);
    url.searchParams.set("name", encodeURIComponent(itemName));
    url.searchParams.set("img", encodeURIComponent(itemImage));
    url.searchParams.set("desc", encodeURIComponent(itemDescription));
    url.searchParams.set("price", encodeURIComponent(itemPrice));

    // Redirect
    window.location.href = url.toString();
  });
});
</script>

<script>
  // Modern Magnifying Glass Inner Hover Zoom Effect
  const zoomContainer = document.querySelector('.modern-product-image-container');
  const zoomImg = document.querySelector('.modern-product-image');

  if (zoomContainer && zoomImg) {
    zoomContainer.addEventListener('mousemove', (e) => {
      if (window.innerWidth < 768) return;
      const rect = zoomContainer.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const xPercent = (x / rect.width) * 100;
      const yPercent = (y / rect.height) * 100;
      
      zoomImg.style.transformOrigin = `${xPercent}% ${yPercent}%`;
    });

    zoomContainer.addEventListener('mouseleave', () => {
      zoomImg.style.transformOrigin = 'center center';
    });
  }
</script>

</html>
