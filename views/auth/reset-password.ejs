<!DOCTYPE html>
<html lang="en">
    <%- include('../../partials/head', {title: 'Reset Password - Acess'}) %>
  <body>
    <!-- stylesheets -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC"
      crossorigin="anonymous"
    />
    <link href="/css/login.css" rel="stylesheet" type="text/css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
    />
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <!-- Navbar -->
    <%- include('../../partials/navbar', { page: 'login' }) %>

    <!-- Reset Password Card -->
    <div class="card form-card shadow-lg mx-auto" style="max-width: 100%; width: 100%; max-width: 600px;">
      <div class="card-body p-5">
        <h3 class="text-center mb-4">
          <img src="/image/moda-logo/logo.png" alt="Moda Logo" style="width: 60px; height: 60px;" />
        </h3>
        <h4 class="text-center fw-bold mb-3">Reset Your Password</h4>
        <p class="text-muted text-center mb-4" style="font-size: 14px;">
          Define a new password for your account. It must be 8–128 characters and include uppercase, lowercase, numbers, and symbols.
        </p>



        <form id="resetForm" class="needs-validation" action="/reset-password" novalidate method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <!-- Secure Token -->
          <input type="hidden" name="token" value="<%= token %>" />

          <!-- New Password -->
          <div class="mb-3">
            <label class="form-label fw-bold">New Password</label>
            <input id="Pass" name="Pass" type="password" class="form-control" placeholder="Enter new password" required />
            <div class="invalid-feedback" id="passFeedback">
              Password must be 8–128 characters, include uppercase, lowercase, numbers, and symbols.
            </div>
          </div>

          <!-- Confirm Password -->
          <div class="mb-4">
            <label class="form-label fw-bold">Confirm Password</label>
            <input id="ConfirmPass" type="password" class="form-control" placeholder="Confirm new password" required />
            <div class="invalid-feedback" id="confirmFeedback">
              Passwords do not match.
            </div>
          </div>

          <!-- Submit -->
          <div class="text-center">
            <button type="submit" class="btn btn-dark w-100">Reset Password</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      (function () {
        "use strict";
        const form = document.getElementById("resetForm");
        const passInput = document.getElementById("Pass");
        const confirmInput = document.getElementById("ConfirmPass");

        form.addEventListener("submit", function (event) {
          let isValid = true;

          // Password regex validation
          const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z\d]).{8,128}$/;
          if (!passwordRegex.test(passInput.value.trim())) {
            passInput.classList.add("is-invalid");
            passInput.classList.remove("is-valid");
            isValid = false;
          } else {
            passInput.classList.remove("is-invalid");
            passInput.classList.add("is-valid");
          }

          // Confirm password match validation
          if (passInput.value !== confirmInput.value) {
            confirmInput.classList.add("is-invalid");
            confirmInput.classList.remove("is-valid");
            isValid = false;
          } else {
            confirmInput.classList.remove("is-invalid");
            confirmInput.classList.add("is-valid");
          }

          if (!form.checkValidity() || !isValid) {
            event.preventDefault();
            event.stopPropagation();
          } else {
            // Prevent button double-click spamming
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Resetting Password...";
            }
          }
          form.classList.add("was-validated");
        }, false);

        // Instant validation on input
        [passInput, confirmInput].forEach(input => {
          input.addEventListener("input", () => {
            input.classList.remove("is-invalid");
          });
        });
      })();
    </script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
