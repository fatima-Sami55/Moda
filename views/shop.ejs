  <script>
    // Dynamically pad the editorial hub so the footer lands exactly at scroll-end.
    // padding-bottom = max(40px, 100vh - footer height)
    function setEditorialPadding() {
      const hub = document.querySelector('.shop-editorial-hub');
      const footer = document.getElementById('footer');
      if (!hub || !footer) return;

      const footerH = footer.getBoundingClientRect().height;
      const required = Math.max(40, window.innerHeight - footerH);
      hub.style.setProperty('padding-bottom', required + 'px', 'important');
    }

    // Run on load and on every resize
    window.addEventListener('load', setEditorialPadding);
    window.addEventListener('resize', setEditorialPadding);
  </script>
