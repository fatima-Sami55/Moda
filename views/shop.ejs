  <!-- Scripts -->
  <script>
    // AJAX Category Filter State Manager (Navbar + Direct Visual Pills)
    document.querySelectorAll('.category-link').forEach(link => {
      link.addEventListener('click', async (e) => {
        e.preventDefault();

        // Using currentTarget to ensure we resolve to the button/link carrying data-category
        const category = e.currentTarget.dataset.category;

        // Sync Active classes for category pills
        document.querySelectorAll('.shop-cat-pill').forEach(btn => {
          if (btn.dataset.category === category) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        try {
          const res = await fetch(`/shop-products?category=${category}`);
          const html = await res.text();

          // Replace the product list container with the updated HTML
          document.querySelector('.container.py-4').innerHTML = html;
          
          // Re-initialize event listeners for dynamic nodes inside updated container
          initializeProductCardEvents();
        } catch (err) {
          console.error('Error loading category:', err);
        }
      });
    });

    // Encapsulate Product Card trigger scripts for dynamic/AJAX content reload support
    function initializeProductCardEvents() {
      document.querySelectorAll(".card-btn").forEach((button) => {
        button.removeEventListener("click", onProductViewClick); // Prevent double bindings
        button.addEventListener("click", onProductViewClick);
      });

      document.querySelectorAll(".card-rating-trigger").forEach((element) => {
        element.removeEventListener("click", onProductRatingClick); // Prevent double bindings
        element.addEventListener("click", onProductRatingClick);
      });
    }

    function onProductViewClick(event) {
      event.preventDefault();
      const productCard = event.target.closest(".product-card");
      if (!productCard) {
        console.error("Product card container node not found");
        return;
      }

      const itemName = productCard.querySelector(".product-name").innerText.trim();
      const itemImage = productCard.querySelector(".card-img-top").src;
      const itemDescription = productCard.querySelector(".product-description").innerText.trim();
      const itemPrice = productCard.querySelector(".product-price").innerText.replace("$", "").trim();

      const url = new URL("/Product", window.location.origin);
      url.searchParams.set("name", encodeURIComponent(itemName));
      url.searchParams.set("img", encodeURIComponent(itemImage));
      url.searchParams.set("desc", encodeURIComponent(itemDescription));
      url.searchParams.set("price", encodeURIComponent(itemPrice));

      window.location.href = url.toString();
    }

    function onProductRatingClick(event) {
      event.preventDefault();
      event.stopPropagation();
      const productCard = event.target.closest(".product-card");
      if (!productCard) return;

      const itemName = productCard.querySelector(".product-name").innerText.trim();
      const itemImage = productCard.querySelector(".card-img-top").src;
      const itemDescription = productCard.querySelector(".product-description").innerText.trim();
      const itemPrice = productCard.querySelector(".product-price").innerText.replace("$", "").trim();

      const url = new URL("/Product", window.location.origin);
      url.searchParams.set("name", encodeURIComponent(itemName));
      url.searchParams.set("img", encodeURIComponent(itemImage));
      url.searchParams.set("desc", encodeURIComponent(itemDescription));
      url.searchParams.set("price", encodeURIComponent(itemPrice));

      window.location.href = url.toString() + "#reviews";
    }

    // Fire initial bindings
    document.addEventListener("DOMContentLoaded", () => {
      initializeProductCardEvents();
    });
  </script>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM"
