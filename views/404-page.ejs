<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', {title: 'Page Not Found — Moda'}) %>
  <body>
    <link href="/css/404-page.css" rel="stylesheet" type="text/css" />

    <main class="error-container">
      <!-- High Impact Error Code -->
      <h1 class="error-code">404</h1>

      <!-- Illustration Area -->
      <div class="illustration-wrapper">
        <img
          src="/image/vectors/404.png"
          alt="Shrugging Character - Page Not Found"
          class="illustration-img"
        />
      </div>

      <!-- Text Blocks -->
      <h2 class="error-title">Whoops! You seem lost.</h2>
      <p class="error-text">
        The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back on track!
      </p>

      <!-- Return Button -->
      <a href="/home" class="home-btn">Return Home</a>
    </main>
  </body>
</html>
